document.addEventListener("DOMContentLoaded", function () {
    const themeToggle = document.getElementById("themeToggle");
    const themeIcon = document.getElementById("themeIcon");
    const fontSize = document.getElementById("fontSize");
    const fontFamily = document.getElementById("fontFamily");

    // Restore saved settings
    const savedTheme = localStorage.getItem("readerTheme");
    const savedSize = localStorage.getItem("readerFontSize");
    const savedFont = localStorage.getItem("readerFontFamily");

    if (savedTheme === "dark") {
        document.body.classList.add("dark-mode");
    }

    if (savedSize) {
        fontSize.value = savedSize;
    }

    if (savedFont) {
        fontFamily.value = savedFont;
    }

    function updateThemeIcon() {
        themeIcon.textContent =
            document.body.classList.contains("dark-mode") ? "☀" : "☾";
    }

    function applyFontSize() {
        document.querySelectorAll("main .chapter").forEach(chapter => {
            chapter.style.fontSize = fontSize.value;
        });

        localStorage.setItem("readerFontSize", fontSize.value);
    }

    function applyFontFamily() {
        document.querySelector("main").style.fontFamily = fontFamily.value;
        localStorage.setItem("readerFontFamily", fontFamily.value);
    }

    themeToggle.addEventListener("click", function () {
        document.body.classList.toggle("dark-mode");

        localStorage.setItem(
            "readerTheme",
            document.body.classList.contains("dark-mode") ? "dark" : "light"
        );

        updateThemeIcon();
    });

    fontSize.addEventListener("change", applyFontSize);
    fontFamily.addEventListener("change", applyFontFamily);

    applyFontSize();
    applyFontFamily();
    updateThemeIcon();
});
   
</script>
