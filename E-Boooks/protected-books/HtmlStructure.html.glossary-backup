    const savedSize = localStorage.getItem("readerFontSize");
    const savedFont = localStorage.getItem("readerFontFamily");

    if (savedTheme === "dark") {
        document.body.classList.add("dark-mode");
    }

    if (savedSize) {
        fontSize.value = savedSize;
    }

    if (savedFont) {
        fontFamily.value = savedFont;
    }

    function updateThemeIcon() {
        themeIcon.textContent =
            document.body.classList.contains("dark-mode") ? "☀" : "☾";
    }

    function applyFontSize() {
        document.querySelectorAll("main .chapter").forEach(chapter => {
            chapter.style.fontSize = fontSize.value;
        });

        localStorage.setItem("readerFontSize", fontSize.value);
    }

    function applyFontFamily() {
        document.querySelector("main").style.fontFamily = fontFamily.value;
        localStorage.setItem("readerFontFamily", fontFamily.value);
    }

    themeToggle.addEventListener("click", function () {
        document.body.classList.toggle("dark-mode");

        localStorage.setItem(
            "readerTheme",
            document.body.classList.contains("dark-mode") ? "dark" : "light"
        );

        updateThemeIcon();
    });

    fontSize.addEventListener("change", applyFontSize);
    fontFamily.addEventListener("change", applyFontFamily);

    applyFontSize();
    applyFontFamily();
    updateThemeIcon();
    const menuToggle = document.getElementById("menuToggle");
    const navLinks = document.getElementById("navLinks");
    if (menuToggle && navLinks) {
        menuToggle.addEventListener("click", function () {
            const opened = navLinks.classList.toggle("show");
            menuToggle.setAttribute("aria-expanded", String(opened));
        });
        navLinks.querySelectorAll("a").forEach(a => a.addEventListener("click", function () {
            navLinks.classList.remove("show");
            menuToggle.setAttribute("aria-expanded", "false");
        }));
    }
    if ("IntersectionObserver" in window) {
        const links = [...document.querySelectorAll('.toc a[href^="#"]')];
        const observer = new IntersectionObserver(entries => {
            for (const entry of entries) {
                if (entry.isIntersecting) {
                    links.forEach(a => a.classList.toggle("current", a.getAttribute("href") === "#" + entry.target.id));
                }
            }
        }, {rootMargin:"-100px 0px -65% 0px"});
        document.querySelectorAll("main .chapter[id]").forEach(el => observer.observe(el));
    }
});

</script>
<script>
document.addEventListener("DOMContentLoaded", function () {

    /* ==========================================
       CODEVERSE - HTML STRUCTURE & SEMANTIC QUIZ
    ========================================== */

    const quizQuestions = document.getElementById("quizQuestions");
    const submitQuiz = document.getElementById("submitQuiz");
    const retryQuiz = document.getElementById("retryQuiz");
    const quizResult = document.getElementById("quizResult");
    const quizProgress = document.getElementById("quizProgress");

    if (!quizQuestions || !submitQuiz || !retryQuiz ||
        !quizResult || !quizProgress) {
        console.error("Quiz elements not found.");
        return;
    }

    const questions = [
        {
            question: "What does HTML stand for?",
            options: [
                "HyperText Markup Language",
                "HyperText Markdown Language",
                "High Technology Markup Language",
                "Hyperlink Text Management Language"
            ],
            answer: 0
        },
        {
            question: "Which HTML element contains the visible content of a webpage?",
            options: [
                "<head>",
                "<title>",
                "<body>",
                "<meta>"
            ],
            answer: 2
        },
        {
            question: "Which HTML element is used to define a paragraph?",
            options: [
                "<h1>",
                "<p>",
                "<br>",
                "<div>"
            ],
            answer: 1
        },
        {
            question: "Which of the following is a void HTML element?",
            options: [
                "<article>",
                "<section>",
                "<footer>",
                "<br>"
            ],
            answer: 3
        },
        {
            question: "What is the main purpose of semantic HTML elements?",
            options: [
                "To make websites load without Internet",
                "To describe the meaning and purpose of webpage content",
                "To replace all CSS styling",
                "To store information in databases"
            ],
            answer: 1
        },
        {
            question: "Which of the following is a non-semantic HTML element?",
            options: [
                "<article>",
                "<header>",
                "<div>",
                "<footer>"
            ],
            answer: 2
        },
        {
            question: "Which semantic element represents independent, self-contained content?",
            options: [
                "<article>",
                "<aside>",
                "<nav>",
                "<main>"
            ],
            answer: 0
        },
        {
            question: "Which semantic HTML element is used for navigation links?",
            options: [
                "<section>",
                "<header>",
                "<footer>",
                "<nav>"
            ],
            answer: 3
        },
        {
            question: "Which semantic element represents the main content of a webpage?",
            options: [
                "<aside>",
                "<main>",
                "<figure>",
                "<span>"
            ],
            answer: 1
        },
        {
            question: "What is an advantage of using semantic HTML elements?",
            options: [
                "They eliminate the need for web browsers",
                "They automatically create a database",
                "They make webpage structure more meaningful and readable",
                "They prevent all website errors"
            ],
            answer: 2
        }
    ];

    let quizSubmitted = false;

    /* ==========================================
       LOAD QUIZ
    ========================================== */

    function loadQuiz() {
        quizSubmitted = false;
        quizQuestions.innerHTML = "";

        questions.forEach((item, index) => {

            const box = document.createElement("div");
            box.className = "quiz-question";

            const heading = document.createElement("h3");
            heading.textContent = `${index + 1}. ${item.question}`;

            box.appendChild(heading);

            item.options.forEach((option, optionIndex) => {

                const label = document.createElement("label");
                label.className = "quiz-option";

                const radio = document.createElement("input");
                radio.type = "radio";
                radio.name = `question${index}`;
                radio.value = optionIndex;

                radio.addEventListener("change", updateProgress);

                const span = document.createElement("span");
                span.textContent = option;

                label.append(radio, span);
                box.appendChild(label);

            });

            quizQuestions.appendChild(box);
        });

        quizResult.hidden = true;
        quizResult.innerHTML = "";
        retryQuiz.hidden = true;
        submitQuiz.hidden = false;
        submitQuiz.disabled = false;

        updateProgress();
    }

    /* ==========================================
       UPDATE PROGRESS
    ========================================== */

    function updateProgress() {
        let answered = 0;

        questions.forEach((item, index) => {
            const selected = quizQuestions.querySelector(
                `input[name="question${index}"]:checked`
            );

            if (selected) answered++;
        });

        quizProgress.textContent =
            `${answered} of ${questions.length} answered`;
    }

    /* ==========================================
       SUBMIT QUIZ
    ========================================== */

    submitQuiz.addEventListener("click", async function () {
        if (quizSubmitted) return;

        const selections = questions.map((item, index) => {
            const selected = quizQuestions.querySelector(
                `input[name="question${index}"]:checked`
            );

            return selected ? Number(selected.value) : null;
        });

        if (selections.includes(null)) {
            alert("Please answer all questions before submitting.");
            return;
        }

        quizSubmitted = true;
        submitQuiz.disabled = true;
        let score = 0;

        questions.forEach((item, index) => {

            const box = quizQuestions.children[index];
            const selectedAnswer = selections[index];

            if (selectedAnswer === item.answer) {
                score++;
            }

            box.querySelectorAll(".quiz-option").forEach(
                (label, optionIndex) => {

                    const radio = label.querySelector("input");
                    radio.disabled = true;

                    if (optionIndex === item.answer) {
                        label.classList.add("correct");
                    } else if (optionIndex === selectedAnswer) {
                        label.classList.add("incorrect");
                    }
                }
            );

            const feedback = document.createElement("p");
            feedback.className = "quiz-feedback";

            feedback.textContent =
                selectedAnswer === item.answer
                    ? "Correct answer!"
                    : `Correct answer: ${item.options[item.answer]}`;

            box.appendChild(feedback);
        });

        /* CALCULATE SCORE */

        const percentage = Math.round(
            (score / questions.length) * 100
        );

        let message;

        if (percentage >= 90) {
            message = "Excellent work!";
        } else if (percentage >= 75) {
            message = "Great job!";
        } else if (percentage >= 60) {
            message = "Good effort! Keep reviewing.";
        } else {
            message = "Review the chapters and try again.";
        }

        quizResult.innerHTML = `
            <h3>Quiz Completed!</h3>
            <p>Your Score</p>
            <h2>${score} / ${questions.length}</h2>
            <p>${percentage}%</p>
            <strong>${message}</strong>
            <p id="quizSaveStatus" aria-live="polite">
                Saving quiz result...
            </p>
        `;

        quizResult.hidden = false;
        submitQuiz.hidden = true;
        retryQuiz.hidden = false;

        quizResult.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });

        /* ==========================================
           SAVE RESULT TO CODEVERSE DATABASE
        ========================================== */

        const saveStatus = document.getElementById("quizSaveStatus");

        try {
            const response = await fetch("/api/quiz-results", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                credentials: "same-origin",
                body: JSON.stringify({
                    bookId: 3,
                    score: score,
                    totalQuestions: questions.length
                })
            });

            const data = await response.json();

            saveStatus.textContent =
                response.ok && data.success
                    ? "Your quiz score has been saved!"
                    : (data.message || "Quiz score could not be saved.");

        } catch (error) {
            console.error("Quiz save error:", error);
            saveStatus.textContent =
                "Quiz completed, but the score could not be saved.";
        }

    });

    /* ==========================================
       RETRY QUIZ
    ========================================== */

    retryQuiz.addEventListener("click", function () {
        loadQuiz();

        document.getElementById("quiz").scrollIntoView({
            behavior: "smooth"
        });
    });

    loadQuiz();

});
</script>
