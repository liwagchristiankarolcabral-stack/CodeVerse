    // ==========================================
    // RENDER QUIZ QUESTIONS
    // ==========================================

    function loadQuiz() {

        quizQuestions.innerHTML = "";

        questions.forEach((item, index) => {

            const questionBox = document.createElement("div");
            questionBox.className = "quiz-question";

            const heading = document.createElement("h3");
            heading.textContent = `${index + 1}. ${item.question}`;

            questionBox.appendChild(heading);

            item.options.forEach((option, optionIndex) => {

                const label = document.createElement("label");
                label.className = "quiz-option";

                const radio = document.createElement("input");
                radio.type = "radio";
                radio.name = `osQuestion${index}`;
                radio.value = optionIndex;

                radio.addEventListener("change", updateProgress);

                const answerText = document.createElement("span");
                answerText.textContent = option;

                label.appendChild(radio);
                label.appendChild(answerText);

                questionBox.appendChild(label);
            });

            quizQuestions.appendChild(questionBox);
        });

        quizResult.hidden = true;
        quizResult.innerHTML = "";

        submitQuiz.hidden = false;
        submitQuiz.disabled = false;
        retryQuiz.hidden = true;

        updateProgress();
    }

    // ==========================================
    // UPDATE ANSWER PROGRESS
    // ==========================================

    function updateProgress() {

        let answered = 0;

        questions.forEach((item, index) => {

            const selected = quizQuestions.querySelector(
                `input[name="osQuestion${index}"]:checked`
            );

            if (selected) {
                answered++;
            }
        });

        quizProgress.textContent =
            `${answered} of ${questions.length} answered`;
    }

    // ==========================================
    // SUBMIT QUIZ
    // ==========================================

    submitQuiz.addEventListener("click", function () {

        let score = 0;
        let answered = 0;

        questions.forEach((item, index) => {

            const selected = quizQuestions.querySelector(
                `input[name="osQuestion${index}"]:checked`
            );

            if (selected) {
                answered++;
            }
        });

        if (answered !== questions.length) {

            alert(
                `Please answer all questions first. ` +
                `You answered ${answered} of ${questions.length}.`
            );

            return;
        }

        questions.forEach((item, index) => {

            const questionBox = quizQuestions.children[index];

            const selected = questionBox.querySelector(
                `input[name="osQuestion${index}"]:checked`
            );

            const selectedAnswer = Number(selected.value);

            if (selectedAnswer === item.answer) {
                score++;
            }

            const labels = questionBox.querySelectorAll(".quiz-option");

            labels.forEach((label, optionIndex) => {

                const radio = label.querySelector("input");
                radio.disabled = true;

                label.classList.remove("correct", "incorrect");

                if (optionIndex === item.answer) {
                    label.classList.add("correct");
                } else if (optionIndex === selectedAnswer) {
                    label.classList.add("incorrect");
                }
            });

            const feedback = document.createElement("p");
            feedback.className = "quiz-feedback";

            if (selectedAnswer === item.answer) {
                feedback.textContent = "Correct answer!";
            } else {
                feedback.textContent =
                    `Correct answer: ${item.options[item.answer]}`;
            }

            questionBox.appendChild(feedback);
        });

        // ==========================================
        // CALCULATE RESULTS
        // ==========================================

        const percentage = Math.round(
            (score / questions.length) * 100
        );

        let message = "";

        if (percentage >= 90) {
            message = "Excellent! You have mastered Operating System Fundamentals.";
        } else if (percentage >= 75) {
            message = "Great job! You understand most operating system concepts.";
        } else if (percentage >= 60) {
            message = "Good effort! Review the topics you missed.";
        } else {
            message = "Keep studying and try the quiz again.";
        }

        quizResult.innerHTML = `
            <h3>Quiz Completed!</h3>
            <p>Your Score</p>
            <h2>${score} / ${questions.length}</h2>
            <p>${percentage}%</p>
            <strong>${message}</strong>
        `;

        quizResult.hidden = false;
        submitQuiz.hidden = true;
        retryQuiz.hidden = false;

        quizResult.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
    });

    // ==========================================
    // RETRY QUIZ
    // ==========================================

    retryQuiz.addEventListener("click", function () {

        loadQuiz();

        document.getElementById("quiz").scrollIntoView({
            behavior: "smooth",
            block: "start"
        });
    });

    loadQuiz();

});
</script>
<script>
