 const fontSize=document.getElementById('fontSize'),fontFamily=document.getElementById('fontFamily');
 const menuToggle=document.getElementById('menuToggle'),navLinks=document.getElementById('navLinks');
 const applyTheme=()=>{const dark=localStorage.getItem('readerTheme')==='dark';document.body.classList.toggle('dark-mode',dark);themeIcon.textContent=dark?'☀':'☾';};
 applyTheme();
 themeToggle?.addEventListener('click',()=>{localStorage.setItem('readerTheme',document.body.classList.contains('dark-mode')?'light':'dark');applyTheme();});
 const savedSize=localStorage.getItem('readerFontSize')||'16px';
 const savedFont=localStorage.getItem('readerFontFamily')||"'DM Sans', sans-serif";
 if([...fontSize.options].some(x=>x.value===savedSize))fontSize.value=savedSize;
 if([...fontFamily.options].some(x=>x.value===savedFont))fontFamily.value=savedFont;
 const applyReader=()=>{document.documentElement.style.setProperty('--reader-size',fontSize.value);document.documentElement.style.setProperty('--reader-font',fontFamily.value);};
 applyReader();
 fontSize.addEventListener('change',()=>{localStorage.setItem('readerFontSize',fontSize.value);applyReader();});
 fontFamily.addEventListener('change',()=>{localStorage.setItem('readerFontFamily',fontFamily.value);applyReader();});
 menuToggle?.addEventListener('click',()=>navLinks?.classList.toggle('open'));
});
