        .contents-header h2 {
            margin: 7px 0 0;
            font-size: 25px;
        }

        .contents-subtitle {
            color: var(--blue);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .09em;
        }

        .close-contents {
            flex-shrink: 0;
            cursor: pointer;
            border: 1px solid var(--line);
            border-radius: 10px;
            background: var(--surface);
            color: var(--text);
            font-size: 27px;
            width: 42px;
            height: 42px;
        }

        /* ==========================================
           SCROLLABLE TABLE OF CONTENTS
        ========================================== */

        .contents-list {
            padding: 10px 20px 22px;
            overflow-y: auto;
            overscroll-behavior: contain;
            scrollbar-width: thin;
        }

        .contents-list a {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 13px 12px;
            border-bottom: 1px solid var(--line);
            border-radius: 7px;
            text-decoration: none;
            color: var(--text);
            font-size: 14px;
            line-height: 1.4;
