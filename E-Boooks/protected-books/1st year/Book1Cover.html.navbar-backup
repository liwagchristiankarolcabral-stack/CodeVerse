        /* ==========================================
           CODEVERSE - STANDALONE BOOK COVER
        ========================================== */

        :root {
            --bg: #f4f7fc;
            --surface: #ffffff;
            --text: #1c2a42;
            --muted: #64748b;
            --line: #e1e8f2;
            --blue: #3157a4;
            --blue-dark: #244581;
            --shadow: 0 18px 50px rgba(22, 48, 91, .09);
        }

        body.dark-mode {
            --bg: #101827;
            --surface: #1d293c;
            --text: #eef3fc;
            --muted: #b2c0d5;
            --line: #38475c;
            --blue: #94b5ff;
            --blue-dark: #bed0ff;
            --shadow: 0 18px 50px rgba(0, 0, 0, .24);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: Arial, sans-serif;
            min-height: 100vh;
            transition: background .25s, color .25s;
        }

        a {
            color: inherit;
        }

        button {
            font: inherit;
        }

        /* ==========================================
           NAVIGATION BAR
        ========================================== */

        .navbar {
            position: sticky;
            top: 0;
            z-index: 50;
            min-height: 78px;
            padding: 14px 5%;
            display: flex;
            align-items: center;
            gap: 34px;
            background: var(--surface);
            border-bottom: 1px solid var(--line);
            box-shadow: 0 3px 14px rgba(0, 0, 0, .025);
            box-sizing: border-box;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -.7px;
            white-space: nowrap;
        }

        .site-logo {
            height: 43px;
            width: 43px;
            object-fit: contain;
        }

        .logo-highlight {
            color: var(--blue);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 28px;
            margin-left: auto;
        }

        .nav-links a {
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            color: var(--muted);
            white-space: nowrap;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: var(--blue);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .icon-btn,
        .menu-toggle {
            border: 1px solid var(--line);
            background: var(--surface);
            color: var(--text);
            cursor: pointer;
            border-radius: 11px;
            min-width: 42px;
            height: 42px;
            font-size: 21px;
        }

        #accountActions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .login-btn,
        .signup-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-weight: 700;
            font-size: 13px;
            padding: 11px 17px;
            border-radius: 10px;
            white-space: nowrap;
        }

        .login-btn {
            border: 1px solid var(--line);
            color: var(--text);
        }

        .signup-btn {
            background: #3157a4;
            color: white;
        }

        .menu-toggle {
            display: none;
        }

        /* ==========================================
           BACK NAVIGATION
        ========================================== */

        .topbar {
            max-width: 1200px;
            margin: 0 auto;
            padding: 28px 24px 0;
        }

        .back-link {
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            color: var(--blue);
        }

        .back-link:hover {
            text-decoration: underline;
        }

        /* ==========================================
           BOOK COVER CONTAINER
        ========================================== */

        .book-container {
            max-width: 1120px;
            margin: 34px auto 80px;
            padding: 40px;
            display: grid;
            grid-template-columns: minmax(250px, 380px) minmax(0, 1fr);
            gap: 60px;
            align-items: center;
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 24px;
            box-shadow: var(--shadow);
            box-sizing: border-box;
        }

        .book-cover-container {
            background: linear-gradient(145deg, #e3edff, #f4f7ff);
            padding: 24px;
            min-height: 410px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
        }

        .book-cover-image {
            display: block;
            max-width: 100%;
            max-height: 470px;
            width: auto;
            height: auto;
            object-fit: contain;
            filter: drop-shadow(0 12px 15px rgba(0, 0, 0, .15));
        }

        .book-details {
            min-width: 0;
        }

        .featured-label {
            display: inline-block;
            background: rgba(49, 87, 164, .11);
            color: var(--blue);
            font-weight: 800;
            font-size: 12px;
            letter-spacing: .08em;
            padding: 9px 13px;
            border-radius: 999px;
        }

        .book-title {
            font-family: Georgia, serif;
            font-weight: 700;
            line-height: 1.15;
            font-size: clamp(30px, 4vw, 49px);
            margin: 22px 0;
        }

        /* ==========================================
           BOOK STATISTICS
        ========================================== */

        .book-stats {
            display: flex;
            gap: 20px;
            margin: 0 0 22px;
        }

        .stat {
            display: flex;
            flex-direction: column;
            gap: 3px;
            padding: 12px 22px;
            background: var(--bg);
            border: 1px solid var(--line);
            border-radius: 12px;
        }

        .stat strong {
            font-size: 23px;
            color: var(--blue);
        }

        .stat span {
            font-size: 12px;
            font-weight: 700;
            color: var(--muted);
        }

        .book-description {
            font-size: 16px;
            line-height: 1.8;
            color: var(--muted);
            max-width: 590px;
        }

        /* ==========================================
           BOOK BUTTONS
        ========================================== */

        .book-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 30px;
        }

        .book-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 49px;
            padding: 12px 24px;
            border-radius: 11px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 800;
            border: 1px solid var(--line);
            color: var(--text);
            background: var(--surface);
            transition: transform .2s, background .2s;
            box-sizing: border-box;
        }

        .book-btn:hover {
            transform: translateY(-2px);
            background: var(--bg);
        }

        .book-btn.primary {
            background: #3157a4;
            color: white;
            border-color: #3157a4;
        }

        .book-btn.primary:hover {
            background: #244581;
        }

        /* ==========================================
           CONTENTS POPUP OVERLAY
        ========================================== */

        .contents-overlay {
            position: fixed;
            inset: 0;
            z-index: 1000;
            display: none;
            align-items: center;
            justify-content: center;
            background: rgba(8, 18, 35, .75);
            padding: 18px;
            box-sizing: border-box;
        }

        .contents-overlay.show {
            display: flex;
        }

        .contents-modal {
            width: min(720px, 100%);
            max-height: min(86vh, 850px);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: var(--surface);
            color: var(--text);
            border: 1px solid var(--line);
            border-radius: 20px;
            box-shadow: 0 25px 90px rgba(0, 0, 0, .28);
        }

        .contents-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 18px;
            padding: 24px 26px 18px;
            border-bottom: 1px solid var(--line);
