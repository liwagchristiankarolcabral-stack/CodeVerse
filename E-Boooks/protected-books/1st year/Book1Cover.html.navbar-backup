            }

            .contents-header {
                padding: 17px;
            }

            .contents-list {
                padding: 8px;
            }

            .contents-list a {
                font-size: 13px;
            }

            .contents-modal {
                max-height: 90vh;
            }
        }

        @media (prefers-reduced-motion: reduce) {

            html {
                scroll-behavior: auto;
            }

            .book-btn,
            body {
                transition: none;
            }
        }
