            background: var(--bg);
            color: var(--blue);
        }

        .contents-number {
            min-width: 29px;
            font-weight: 800;
            color: var(--blue);
        }

        .contents-name {
            flex: 1;
        }

        .contents-arrow {
            font-size: 24px;
            color: var(--muted);
