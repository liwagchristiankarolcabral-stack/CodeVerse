    <script>
        document.addEventListener("DOMContentLoaded", function () {

            /* MOBILE NAVIGATION */

            const menuToggle = document.getElementById("menuToggle");
            const navLinks = document.getElementById("navLinks");

            menuToggle.addEventListener("click", function () {

                const visible = navLinks.classList.toggle("show");

                menuToggle.setAttribute(
                    "aria-expanded",
                    String(visible)
                );

            });


            /* DARK MODE */

            const themeToggle = document.getElementById("themeToggle");
            const themeIcon = document.getElementById("themeIcon");

            function applyTheme() {

                const isDark =
                    localStorage.getItem("theme") === "dark";

                document.body.classList.toggle("dark-mode", isDark);

                themeIcon.textContent = isDark ? "☀" : "☾";

            }

            applyTheme();

            themeToggle.addEventListener("click", function () {

                const isDark =
                    document.body.classList.contains("dark-mode");

                localStorage.setItem(
                    "theme",
                    isDark ? "light" : "dark"
                );

                applyTheme();

            });


            /* TABLE OF CONTENTS */

            const contentsBtn = document.getElementById("contentsBtn");
            const contentsPopup = document.getElementById("contentsPopup");
            const closeContents = document.getElementById("closeContents");

            let lastFocus = null;

            function hideContents() {

                contentsPopup.classList.remove("show");

                document.body.style.overflow = "";

                if (lastFocus) {
                    lastFocus.focus();
                }

            }

            contentsBtn.addEventListener("click", function (event) {

                event.preventDefault();

                lastFocus = document.activeElement;

                contentsPopup.classList.add("show");

                document.body.style.overflow = "hidden";

                closeContents.focus();

            });

            closeContents.addEventListener("click", hideContents);

            contentsPopup.addEventListener("click", function (event) {

                if (event.target === contentsPopup) {
                    hideContents();
                }

            });

            /* KEYBOARD CONTROLS */

            document.addEventListener("keydown", function (event) {

                if (!contentsPopup.classList.contains("show")) {
                    return;
                }

                if (event.key === "Escape") {
                    hideContents();
                    return;
                }

                if (event.key === "Tab") {

                    const links = [
                        closeContents,
                        ...contentsPopup.querySelectorAll(".contents-list a")
                    ];

                    const first = links[0];
                    const last = links[links.length - 1];

                    if (
                        event.shiftKey &&
                        document.activeElement === first
                    ) {
                        event.preventDefault();
                        last.focus();
                    } else if (
                        !event.shiftKey &&
                        document.activeElement === last
                    ) {
                        event.preventDefault();
                        first.focus();
                    }

                }

            });

        });
    </script>

    <!-- CODEVERSE ACCOUNT NAVIGATION -->
    <script src="/js/auth-nav.js" defer></script>

