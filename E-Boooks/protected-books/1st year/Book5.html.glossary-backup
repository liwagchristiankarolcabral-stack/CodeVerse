    // ==========================================
    // UPDATE PROGRESS
    // ==========================================

    function updateProgress() {

        let answered = 0;

        questions.forEach((item, index) => {

            const selected = quizQuestions.querySelector(
                `input[name="question${index}"]:checked`
            );

            if (selected) answered++;
        });

        quizProgress.textContent =
            `${answered} of ${questions.length} answered`;
    }

    // ==========================================
    // SUBMIT QUIZ
    // ==========================================

    submitQuiz.addEventListener("click", function () {

        let score = 0;
        let answered = 0;

        questions.forEach((item, index) => {

            const selected = quizQuestions.querySelector(
                `input[name="question${index}"]:checked`
            );

            if (selected) answered++;
        });

        if (answered !== questions.length) {

            alert(
                `Please answer all questions first. ` +
                `You answered ${answered} of ${questions.length}.`
            );

            return;
        }

        questions.forEach((item, index) => {

            const questionBox = quizQuestions.children[index];

            const selected = questionBox.querySelector(
                `input[name="question${index}"]:checked`
            );

            const selectedAnswer = Number(selected.value);

            if (selectedAnswer === item.answer) {
                score++;
            }

            const labels = questionBox.querySelectorAll(".quiz-option");

            labels.forEach((label, optionIndex) => {

                const radio = label.querySelector("input");
                radio.disabled = true;

                if (optionIndex === item.answer) {
                    label.classList.add("correct");
                } else if (optionIndex === selectedAnswer) {
                    label.classList.add("incorrect");
                }
            });

            const feedback = document.createElement("p");
            feedback.className = "quiz-feedback";

            feedback.textContent =
                selectedAnswer === item.answer
                    ? "Correct answer!"
                    : `Correct answer: ${item.options[item.answer]}`;

            questionBox.appendChild(feedback);
        });

        const percentage = Math.round(
            (score / questions.length) * 100
        );

        let message = "";

        if (percentage >= 90) {
            message = "Excellent! You have mastered the lesson.";
        } else if (percentage >= 75) {
            message = "Great job! You understand most of the topics.";
        } else if (percentage >= 60) {
            message = "Good effort! Review the questions you missed.";
        } else {
            message = "Keep studying and try again.";
        }

        quizResult.innerHTML = `
            <h3>Quiz Completed!</h3>
            <p>Your Score</p>
            <h2>${score} / ${questions.length}</h2>
            <p>${percentage}%</p>
            <strong>${message}</strong>
        `;

        quizResult.hidden = false;
        submitQuiz.hidden = true;
        retryQuiz.hidden = false;

        quizResult.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
    });

    // ==========================================
    // RETRY QUIZ
    // ==========================================

    retryQuiz.addEventListener("click", function () {

        loadQuiz();

        document.getElementById("quiz").scrollIntoView({
            behavior: "smooth",
            block: "start"
        });
    });

    loadQuiz();

});
</script>
