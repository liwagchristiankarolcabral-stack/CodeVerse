    /* ======================================
       QUIZ PROGRESS
    ====================================== */

    function updateProgress() {

        let answered = 0;

        questions.forEach((question, index) => {

            const selected =
                document.querySelector(
                    `input[name="question${index}"]:checked`
                );

            if (selected) {
                answered++;
            }
        });

        quizProgress.textContent =
            `${answered} of ${questions.length} answered`;
    }

    /* ======================================
       LOAD QUIZ
    ====================================== */

    function loadQuiz() {

        quizQuestions.innerHTML = "";

        quizResult.hidden = true;
        quizResult.textContent = "";

        submitQuiz.hidden = false;
        retryQuiz.hidden = true;

        questions.forEach((item, index) => {

            const box = document.createElement("div");
            box.className = "quiz-question";

            const heading = document.createElement("h3");

            heading.textContent =
                `${index + 1}. ${item.question}`;

            box.appendChild(heading);

            item.options.forEach((option, optionIndex) => {

                const label =
                    document.createElement("label");

                label.className = "quiz-option";

                const radio =
                    document.createElement("input");

                radio.type = "radio";
                radio.name = `question${index}`;
                radio.value = String(optionIndex);

                radio.addEventListener(
                    "change",
                    updateProgress
                );

                const span =
                    document.createElement("span");

                span.textContent = option;

                label.append(radio, span);

                box.appendChild(label);
            });

            quizQuestions.appendChild(box);
        });

        updateProgress();
    }

    /* ======================================
       SUBMIT QUIZ
    ====================================== */

    submitQuiz.addEventListener("click", () => {

        let score = 0;
        let answered = 0;

        questions.forEach((item, index) => {

            const selected =
                document.querySelector(
                    `input[name="question${index}"]:checked`
                );

            const questionBox =
                quizQuestions.children[index];

            if (selected) {

                answered++;

                if (
                    Number(selected.value) === item.answer
                ) {
                    score++;
                }
            }

            const labels =
                questionBox.querySelectorAll(".quiz-option");

            labels.forEach((label, optionIndex) => {

                const radio =
                    label.querySelector("input");

                radio.disabled = true;

                if (optionIndex === item.answer) {

                    label.style.borderColor = "#198754";

                } else if (
                    radio.checked &&
                    optionIndex !== item.answer
                ) {

                    label.style.borderColor = "#dc3545";

                }
            });
        });

        if (answered < questions.length) {

            alert(
                `Please answer all ${questions.length} questions before submitting.`
            );

            // Restore the quiz for completion.
            questions.forEach((item, index) => {

                const box = quizQuestions.children[index];

                box.querySelectorAll(
                    "input[type='radio']"
                ).forEach(input => {
                    input.disabled = false;
                });

                box.querySelectorAll(
                    ".quiz-option"
                ).forEach(label => {
                    label.style.borderColor = "";
                });
            });

            return;
        }

        const percentage =
            Math.round((score / questions.length) * 100);

        const passed = percentage >= 75;

        quizResult.hidden = false;

        quizResult.replaceChildren();

        const heading = document.createElement("h3");

        heading.textContent = passed
            ? "Assessment Passed!"
            : "Assessment Completed";

        heading.style.color = passed
            ? "#198754"
            : "#dc3545";

        const scoreText = document.createElement("p");

        scoreText.textContent =
            `Your Score: ${score} / ${questions.length} (${percentage}%)`;

        const statusText = document.createElement("p");

        statusText.textContent = passed
            ? "Congratulations! You demonstrated a good understanding of the lesson."
            : "Review the lesson and try again to improve your score.";

        quizResult.append(
            heading,
            scoreText,
            statusText
        );

        submitQuiz.hidden = true;
        retryQuiz.hidden = false;

        quizResult.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
    });

