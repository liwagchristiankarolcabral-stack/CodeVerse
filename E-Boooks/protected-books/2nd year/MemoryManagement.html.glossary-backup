   DISPLAY QUIZ RESULT
========================================== */

function displayQuizResult(score) {

    const percentage =
        score / TOTAL_QUESTIONS * 100;

    const passed =
        score >= PASSING_SCORE;

    quizResult.hidden = false;

    quizResult.className =
        passed
            ? "quiz-result passed"
            : "quiz-result failed";

    quizResult.replaceChildren();

    const heading =
        document.createElement("h2");

    heading.textContent =
        passed
            ? "Congratulations! You Passed!"
            : "Assessment Not Passed";

    const scoreText =
        document.createElement("p");

    scoreText.textContent =
        `Your Score: ${score} / ${TOTAL_QUESTIONS}`;

    const percentageText =
        document.createElement("p");

    percentageText.textContent =
        `Percentage: ${percentage.toFixed(2)}%`;

    const passingText =
        document.createElement("p");

    passingText.textContent =
        `Passing Score: ${PASSING_SCORE} / ` +
        `${TOTAL_QUESTIONS} (75%)`;

    const message =
        document.createElement("p");

    if (passed) {

        message.textContent =
            "You have successfully completed " +
            "the Memory Management and Virtual " +
            "Memory assessment.";

    } else {

        message.textContent =
            "Review the highlighted answers " +
            "and try again to improve your score.";

    }

    quizResult.append(
        heading,
        scoreText,
        percentageText,
        passingText,
        message
    );

    retryQuiz.hidden = false;

    submitQuiz.hidden = true;

    quizResult.scrollIntoView({
        behavior: "smooth",
        block: "center"
    });

}


/* ==========================================
   SUBMIT QUIZ
========================================== */

quizForm.addEventListener(
    "submit",
    function (event) {

        event.preventDefault();

        if (quizSubmitted) {
            return;
        }

        if (!validateAnswers()) {
            return;
        }

        quizSubmitted = true;

        const score = checkQuiz();

        displayQuizResult(score);

    }
);


