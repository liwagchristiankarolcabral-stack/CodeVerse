const submitQuiz =
    document.getElementById("submitQuiz");

const retryQuiz =
    document.getElementById("retryQuiz");


/* ==========================================
   QUIZ SETTINGS
========================================== */

const TOTAL_QUESTIONS = questions.length;

const PASSING_PERCENTAGE = 75;

const PASSING_SCORE = Math.ceil(
    TOTAL_QUESTIONS *
    PASSING_PERCENTAGE / 100
);

let quizSubmitted = false;


/* ==========================================
   QUIZ RENDERING
========================================== */

function renderQuiz() {

    quizSubmitted = false;

    quizQuestions.innerHTML = "";

    quizResult.innerHTML = "";

    quizResult.hidden = true;

    retryQuiz.hidden = true;

    submitQuiz.hidden = false;

    questions.forEach(
        function (question, index) {

            const container =
                document.createElement("div");

            container.className =
                "quiz-question";

            container.dataset.questionIndex =
                String(index);

            const heading =
                document.createElement("h3");

            heading.textContent =
                `${index + 1}. ${question.q}`;

            container.appendChild(heading);

            question.options.forEach(
                function (option, optionIndex) {

                    const label =
                        document.createElement("label");

                    label.className =
                        "quiz-option";

                    const input =
                        document.createElement("input");

                    input.type = "radio";

                    input.name =
                        `question${index}`;

                    input.value =
                        String(optionIndex);

                    input.required = true;

                    const optionText =
                        document.createElement("span");

                    const letter =
                        String.fromCharCode(
                            65 + optionIndex
                        );

                    optionText.textContent =
                        `${letter}. ${option}`;

                    label.appendChild(input);

                    label.appendChild(optionText);

                    container.appendChild(label);

                }
            );

            const feedback =
                document.createElement("div");

            feedback.className =
                "quiz-feedback";

            feedback.hidden = true;

            feedback.setAttribute(
                "aria-live",
                "polite"
            );

            container.appendChild(feedback);

            quizQuestions.appendChild(container);

        }
    );

    updateProgress();

}


/* ==========================================
   QUIZ PROGRESS
========================================== */

function updateProgress() {

    let answered = 0;

    questions.forEach(
        function (question, index) {

            const selected =
                quizForm.querySelector(
                    `input[name="question${index}"]:checked`
                );

            if (selected) {
                answered++;
            }

        }
    );

    quizProgress.textContent =
        `${answered} of ${TOTAL_QUESTIONS} answered`;

    const percentage =
        answered / TOTAL_QUESTIONS * 100;

    progressFill.style.width =
        `${percentage}%`;

    quizProgressBar.setAttribute(
        "aria-valuenow",
        String(answered)
    );

}

quizForm.addEventListener(
    "change",
    function () {

        if (!quizSubmitted) {
            updateProgress();
        }

    }
);


/* ==========================================
   ANSWER VALIDATION
========================================== */

function validateAnswers() {

    let answered = 0;

    let firstUnanswered = null;

    questions.forEach(
        function (question, index) {

            const selected =
                quizForm.querySelector(
                    `input[name="question${index}"]:checked`
                );

            const container =
                quizQuestions.querySelector(
                    `[data-question-index="${index}"]`
                );

            container.style.borderColor = "";

            if (selected) {

                answered++;

            } else {

                container.style.borderColor =
                    "#d35b5b";

                if (!firstUnanswered) {
                    firstUnanswered = container;
                }

            }

        }
    );

    if (answered !== TOTAL_QUESTIONS) {

        const remaining =
            TOTAL_QUESTIONS - answered;

        quizResult.hidden = false;

        quizResult.className =
            "quiz-result";

        quizResult.replaceChildren();

        const message =
            document.createElement("p");

        message.textContent =
            `Please answer all questions before submitting. ` +
            `${remaining} question(s) remaining.`;

        quizResult.appendChild(message);

        firstUnanswered?.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });

        firstUnanswered
            ?.querySelector("input")
            ?.focus({ preventScroll: true });

        return false;

    }

    return true;

}


/* ==========================================
   CHECK QUIZ ANSWERS
========================================== */

function checkQuiz() {

    let score = 0;

    questions.forEach(
        function (question, index) {

            const selected =
                quizForm.querySelector(
                    `input[name="question${index}"]:checked`
                );

            const selectedAnswer =
                Number(selected.value);

            const correctAnswer =
                question.answer;

            const container =
                quizQuestions.querySelector(
                    `[data-question-index="${index}"]`
                );

            const feedback =
                container.querySelector(
                    ".quiz-feedback"
                );

            const isCorrect =
                selectedAnswer === correctAnswer;

            if (isCorrect) {
                score++;
            }

            const options =
                container.querySelectorAll(
                    ".quiz-option"
                );

            options.forEach(
                function (label, optionIndex) {

                    const input =
                        label.querySelector("input");

                    input.disabled = true;

                    label.classList.remove(
                        "correct",
                        "incorrect"
                    );

                    if (
                        optionIndex === correctAnswer
                    ) {

                        label.classList.add(
                            "correct"
                        );

                    } else if (
                        optionIndex === selectedAnswer
                    ) {

                        label.classList.add(
                            "incorrect"
                        );

                    }

                }
            );

            const correctLetter =
                String.fromCharCode(
                    65 + correctAnswer
                );

            feedback.hidden = false;

            if (isCorrect) {

                feedback.className =
                    "quiz-feedback correct";

                feedback.textContent =
                    "Correct! " +
                    question.options[correctAnswer] +
                    " is the correct answer.";

            } else {

                feedback.className =
                    "quiz-feedback incorrect";

                feedback.textContent =
                    "Incorrect. The correct answer is " +
                    correctLetter + ". " +
                    question.options[correctAnswer] +
                    ".";

            }

        }
    );

    return score;

}


