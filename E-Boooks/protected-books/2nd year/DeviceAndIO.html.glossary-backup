            /* =====================================
               QUIZ SETTINGS
            ====================================== */

            const PASSING_PERCENTAGE = 75;

            const PASSING_SCORE = Math.ceil(
                questions.length * PASSING_PERCENTAGE / 100
            );

            const quizQuestions =
                document.getElementById("quizQuestions");

            const quizProgress =
                document.getElementById("quizProgress");

            const submitQuiz =
                document.getElementById("submitQuiz");

            const retryQuiz =
                document.getElementById("retryQuiz");

            const quizResult =
                document.getElementById("quizResult");

            let quizSubmitted = false;


            /* =====================================
               LOAD QUIZ
            ====================================== */

            function loadQuiz() {

                quizSubmitted = false;

                quizQuestions.innerHTML = "";

                questions.forEach(function (item, index) {

                    const box =
                        document.createElement("div");

                    box.className = "quiz-question";

                    const heading =
                        document.createElement("h3");

                    heading.textContent =
                        (index + 1) + ". " + item.question;

                    box.appendChild(heading);


                    /* ANSWER OPTIONS */

                    item.options.forEach(function (
                        option,
                        optionIndex
                    ) {

                        const label =
                            document.createElement("label");

                        label.className = "quiz-option";

                        const radio =
                            document.createElement("input");

                        radio.type = "radio";

                        radio.name = "question" + index;

                        radio.value = optionIndex;

                        radio.addEventListener(
                            "change",
                            updateProgress
                        );

                        const text =
                            document.createElement("span");

                        text.textContent = option;

                        label.appendChild(radio);

                        label.appendChild(text);

                        box.appendChild(label);

                    });


                    /* ANSWER FEEDBACK */

                    const feedback =
                        document.createElement("p");

                    feedback.className = "quiz-feedback";

                    feedback.hidden = true;

                    box.appendChild(feedback);

                    quizQuestions.appendChild(box);

                });


                /* RESET QUIZ */

                quizResult.hidden = true;

                quizResult.innerHTML = "";

                submitQuiz.hidden = false;

                retryQuiz.hidden = true;

                updateProgress();

            }


            /* =====================================
               UPDATE QUIZ PROGRESS
            ====================================== */

            function updateProgress() {

                let answered = 0;

                questions.forEach(function (item, index) {

                    const selected =
                        quizQuestions.querySelector(
                            'input[name="question' +
                            index +
                            '"]:checked'
                        );

                    if (selected) {
                        answered++;
                    }

                });

                quizProgress.textContent =
                    answered +
                    " of " +
                    questions.length +
                    " answered";

            }


            /* =====================================
               SUBMIT QUIZ
            ====================================== */

            submitQuiz.addEventListener("click", function () {

                if (quizSubmitted) {
                    return;
                }


                /* COLLECT ANSWERS */

                const answers = questions.map(function (
                    item,
                    index
                ) {

                    const selected =
                        quizQuestions.querySelector(
                            'input[name="question' +
                            index +
                            '"]:checked'
                        );

                    return selected
                        ? Number(selected.value)
                        : null;

                });


                /* CHECK UNANSWERED QUESTIONS */

                const answered = answers.filter(function (
                    answer
                ) {

                    return answer !== null;

                }).length;

                if (answered !== questions.length) {

                    alert(
                        "Please answer all questions.\n\n" +
                        "You answered " +
                        answered +
                        " out of " +
                        questions.length +
                        " questions."
                    );

                    return;

                }


                /* CALCULATE SCORE */

                quizSubmitted = true;

                let score = 0;

                questions.forEach(function (item, index) {

                    const box =
                        quizQuestions.children[index];

                    const selectedAnswer =
                        answers[index];

                    const isCorrect =
                        selectedAnswer === item.answer;

                    if (isCorrect) {
                        score++;
                    }


                    /* MARK ANSWERS */

                    const options =
                        box.querySelectorAll(".quiz-option");

                    options.forEach(function (
                        label,
                        optionIndex
                    ) {

                        const radio =
                            label.querySelector("input");

                        radio.disabled = true;

                        if (optionIndex === item.answer) {

                            label.classList.add("correct");

                        } else if (
                            optionIndex === selectedAnswer
                        ) {

                            label.classList.add("incorrect");

                        }

                    });


                    /* SHOW QUESTION FEEDBACK */

                    const feedback =
                        box.querySelector(".quiz-feedback");

                    feedback.hidden = false;

                    if (isCorrect) {

                        feedback.textContent =
                            "Correct answer!";

                        feedback.classList.add("correct");

                    } else {

                        feedback.textContent =
                            "Incorrect. Correct answer: " +
                            item.options[item.answer];

                        feedback.classList.add("incorrect");

                    }

                });


                /* CALCULATE PERCENTAGE */

                const exactPercentage =
                    (score / questions.length) * 100;

                const displayedPercentage =
                    Math.round(exactPercentage);

                const passed =
                    score >= PASSING_SCORE;


                /* RESULT MESSAGE */

                let message;

                if (passed && exactPercentage >= 90) {

                    message =
                        "Excellent! You have mastered the lesson.";

                } else if (passed) {

                    message =
                        "Great job! You have a strong understanding.";

                } else if (exactPercentage >= 60) {

                    message =
                        "Good effort! Review the topics you missed.";

                } else {

                    message =
                        "Keep studying and try again!";

                }


                /* DISPLAY RESULTS */

                quizResult.innerHTML = "";

                quizResult.classList.remove(
                    "passed",
                    "failed"
                );

                quizResult.classList.add(
                    passed ? "passed" : "failed"
                );


                const heading =
                    document.createElement("h3");

                heading.textContent =
                    passed
                        ? "Congratulations! You Passed!"
                        : "Quiz Completed — Not Passed";


                const scoreText =
                    document.createElement("h2");

                scoreText.textContent =
                    score +
                    " / " +
                    questions.length;


                const percentText =
                    document.createElement("p");

                percentText.textContent =
                    "Your Score: " +
                    displayedPercentage +
                    "%";


                const passingText =
                    document.createElement("p");

                passingText.textContent =
                    "Passing Score: " +
                    PASSING_PERCENTAGE +
                    "% (" +
                    PASSING_SCORE +
                    " out of " +
                    questions.length +
                    ")";


                const statusText =
                    document.createElement("p");

                statusText.textContent =
                    "Status: " +
                    (passed ? "PASSED" : "FAILED");


                const messageText =
                    document.createElement("p");

                messageText.textContent = message;


                quizResult.appendChild(heading);

                quizResult.appendChild(scoreText);

                quizResult.appendChild(percentText);

                quizResult.appendChild(passingText);

                quizResult.appendChild(statusText);

                quizResult.appendChild(messageText);


                /* DISPLAY BUTTONS */

                quizResult.hidden = false;

                submitQuiz.hidden = true;

                retryQuiz.hidden = false;


                /* SCROLL TO RESULT */

                quizResult.scrollIntoView({

                    behavior: "smooth",

                    block: "center"

                });

            });


