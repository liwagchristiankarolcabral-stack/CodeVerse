        /* ==========================================
           CODEVERSE DIGITAL E-BOOK READER
           DEVICE AND INPUT/OUTPUT MANAGEMENT
        ========================================== */

        :root {
            --primary: #3157a4;
            --primary-dark: #24427f;
            --background: #f7f9fd;
            --surface: #ffffff;
            --surface-alt: #edf2fa;
            --text: #202b40;
            --muted: #758096;
            --border: #e6eaf1;
            --shadow: 0 8px 30px rgba(30, 50, 90, .07);
            --reader-size: 16px;
            --reader-family: 'DM Sans', sans-serif;
        }

        /* ==========================================
           DARK MODE VARIABLES
        ========================================== */

        body.dark-mode {
            --primary: #91b5ff;
            --primary-dark: #b8ceff;
            --background: #111827;
            --surface: #1e293b;
            --surface-alt: #29384d;
            --text: #f1f5f9;
            --muted: #b0bed0;
            --border: #39485d;
            --shadow: 0 8px 30px rgba(0, 0, 0, .2);
        }

        /* ==========================================
           GENERAL
        ========================================== */

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 100px;
        }

        body {
            margin: 0;
            background: var(--background);
            color: var(--text);
            font-family: 'DM Sans', Arial, sans-serif;
            transition: background .3s, color .3s;
        }

        body,
        body *,
        body *::before,
        body *::after {
            box-sizing: border-box;
        }

        a {
            color: var(--primary);
        }

        button,
        select {
            font-family: inherit;
        }


/* ==========================================
   CODEVERSE LOGIN AND SIGN UP BUTTONS
========================================== */

.btn-login,
.btn-signup {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 18px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: all .2s ease;
}

.btn-login {
    color: var(--primary);
    background: transparent;
    border: 1px solid var(--primary);
}

.btn-login:hover {
    background: var(--surface-alt);
}

.btn-signup {
    background: #3157a4;
    color: #ffffff;
    border: 1px solid #3157a4;
}

.btn-signup:hover {
    background: #24427f;
    border-color: #24427f;
}

@media (max-width: 540px) {
    .nav-actions {
        gap: 6px;
    }

    .btn-login,
    .btn-signup {
        padding: 9px 10px;
        font-size: 12px;
    }
}


        /* ==========================================
           NAVIGATION BAR
        ========================================== */

        .navbar {
            min-height: 82px;
            position: sticky;
            top: 0;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 12px 5%;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            box-shadow: var(--shadow);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--text);
            font-size: 24px;
            font-weight: 800;
            white-space: nowrap;
        }

        .site-logo {
            width: 42px;
            height: 42px;
            object-fit: contain;
        }

        .logo-highlight {
            color: var(--primary);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .nav-links a {
            color: var(--text);
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            transition: color .2s;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: var(--primary);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .icon-btn,
        .menu-toggle {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--text);
            border-radius: 9px;
            font-size: 21px;
            cursor: pointer;
        }

        .menu-toggle {
            display: none;
        }

        /* ==========================================
           TOP BAR
        ========================================== */

        .topbar {
            padding: 18px 5%;
        }

        .back-link {
            color: var(--primary);
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        /* ==========================================
           READING CONTROLS
        ========================================== */

        .reading-controls {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 22px;
            padding: 16px 5%;
            background: var(--surface);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .control-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .control-group label {
            font-size: 13px;
            font-weight: 700;
        }

        .control-group select {
            min-width: 130px;
            padding: 9px 12px;
            background: var(--surface);
            color: var(--text);
            border: 1px solid var(--border);
            border-radius: 8px;
            cursor: pointer;
        }

        /* ==========================================
           MAIN READER LAYOUT
        ========================================== */

        .layout {
            max-width: 1400px;
            margin: 30px auto;
            padding: 0 20px;
            display: grid;
            grid-template-columns: 280px minmax(0, 1fr);
            gap: 30px;
            align-items: start;
        }

        .layout main {
            min-width: 0;
        }

        /* ==========================================
           TABLE OF CONTENTS
        ========================================== */

        .toc {
            position: sticky;
            top: 100px;
            align-self: start;
            max-height: calc(100vh - 120px);
            overflow-y: auto;
            overflow-x: hidden;
            background: var(--surface);
            padding: 22px;
            border: 1px solid var(--border);
            border-radius: 14px;
            box-shadow: var(--shadow);
            scrollbar-width: thin;
            scrollbar-color: var(--primary) var(--background);
        }

        .toc::-webkit-scrollbar {
            width: 7px;
        }

        .toc::-webkit-scrollbar-track {
            background: var(--background);
            border-radius: 10px;
        }

        .toc::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 10px;
        }

        .toc h2 {
            margin-top: 0;
            margin-bottom: 18px;
            font-size: 18px;
            color: var(--text);
        }

        .toc nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .toc a {
            display: block;
            padding: 9px 10px;
            border-radius: 7px;
            text-decoration: none;
            font-size: 13px;
            line-height: 1.5;
            color: var(--muted);
            transition: background .2s, color .2s;
        }

        .toc a:hover {
            background: var(--background);
            color: var(--primary);
        }

        .toc a.active {
            background: var(--surface-alt);
            color: var(--primary);
            font-weight: 800;
            border-left: 3px solid var(--primary);
        }

        .toc .toc-part {
            margin-top: 12px;
            font-weight: 800;
            color: var(--primary);
        }

        /* ==========================================
           BOOK HEADER
        ========================================== */

        .book-header {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 35px;
            margin-bottom: 24px;
            box-shadow: var(--shadow);
        }

        .book-header h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(30px, 4vw, 44px);
            line-height: 1.25;
            margin: 12px 0 18px;
            color: var(--text);
        }

        .book-header p {
            color: var(--muted);
            font-size: 16px;
            line-height: 1.8;
        }

        .eyebrow {
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1px;
            color: var(--primary);
        }

        /* ==========================================
           CHAPTER CONTENT
        ========================================== */

        .chapter {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 32px;
            margin-bottom: 24px;
            box-shadow: var(--shadow);
            scroll-margin-top: 105px;
            font-size: var(--reader-size);
            font-family: var(--reader-family);
            line-height: 1.85;
        }

        .chapter h2 {
            font-size: 1.6em;
            line-height: 1.35;
            margin-top: 5px;
            margin-bottom: 20px;
            color: var(--text);
        }

        .chapter h3 {
            margin-top: 26px;
            margin-bottom: 12px;
            font-size: 1.2em;
            color: var(--text);
        }

        .chapter p {
            color: var(--text);
            line-height: 1.85;
            margin: 12px 0 18px;
        }

        .chapter li {
            margin-bottom: 8px;
            color: var(--text);
        }

        .chapter ul,
        .chapter ol {
            padding-left: 25px;
            margin: 15px 0 22px;
        }

        .part-heading {
            color: var(--primary);
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .5px;
            font-size: 12px;
        }

        /* ==========================================
           EXAMPLE BOX
        ========================================== */

        .example-box {
            margin: 20px 0;
            padding: 18px 20px;
            background: var(--background);
            border-left: 4px solid var(--primary);
            border-radius: 9px;
        }

        .example-box p:last-child {
            margin-bottom: 0;
        }

        /* ==========================================
           TABLES
        ========================================== */

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
            margin: 18px 0;
        }

        .chapter table {
            width: 100%;
            border-collapse: collapse;
            font-size: .92em;
        }

        .chapter th,
        .chapter td {
            padding: 12px;
            border: 1px solid var(--border);
            text-align: left;
            vertical-align: top;
        }

        .chapter th {
            background: var(--background);
            font-weight: 800;
        }

        /* ==========================================
           QUIZ STYLES
           FUNCTIONALITY ADDED IN PART 4
        ========================================== */

        .quiz-question {
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 20px;
            margin: 18px 0;
        }

        .quiz-question h3 {
            margin-top: 0;
        }

        .quiz-option {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 12px;
            margin: 8px 0;
            border: 1px solid var(--border);
            border-radius: 8px;
            cursor: pointer;
        }

        .quiz-option:hover {
            background: var(--background);
        }

        .quiz-option input {
            margin-top: 7px;
            accent-color: #3157a4;
        }

        .quiz-option.correct {
            border-color: #26a269;
            background: rgba(38, 162, 105, .12);
        }

        .quiz-option.incorrect {
            border-color: #dc5360;
            background: rgba(220, 83, 96, .12);
        }

        .quiz-feedback {
            font-weight: 700;
            line-height: 1.7;
            margin-top: 12px;
        }

        .quiz-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 24px;
        }

        .quiz-actions button {
            padding: 13px 24px;
            border: none;
            border-radius: 9px;
            background: #3157a4;
            color: white;
            font-family: inherit;
            font-weight: 700;
            cursor: pointer;
        }

        .quiz-actions button:hover {
            background: #24427f;
        }

        .quiz-actions button:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

        #quizResult {
            margin-top: 22px;
            padding: 24px;
            border: 1px solid var(--border);
            border-radius: 12px;
            text-align: center;
        }

        #quizResult.passed {
            border-color: #26a269;
        }

        #quizResult.failed {
            border-color: #dc5360;
        }

        #quizProgress {
            font-weight: 700;
            color: var(--primary);
        }

        /* ==========================================
           ACCESSIBILITY
        ========================================== */

        .toc a:focus-visible,
        .icon-btn:focus-visible,
        .menu-toggle:focus-visible,
        .quiz-actions button:focus-visible,
        .control-group select:focus-visible {
            outline: 3px solid var(--primary);
            outline-offset: 3px;
        }

        [hidden] {
            display: none !important;
        }

        /* ==========================================
           FOOTER
        ========================================== */

        .page-footer {
            padding: 25px;
            text-align: center;
            color: var(--muted);
            font-size: 13px;
        }

        /* ==========================================
           RESPONSIVE DESIGN
        ========================================== */

        @media (max-width: 1000px) {

            .layout {
                grid-template-columns: 240px minmax(0, 1fr);
                gap: 20px;
            }

            .nav-links {
                gap: 14px;
            }

        }

        @media (max-width: 900px) {

            .layout {
                grid-template-columns: 1fr;
            }

            .toc {
                position: relative;
                top: 0;
                max-height: 300px;
            }

            .nav-links {
                display: none;
            }

            .nav-links.show {
                position: absolute;
                top: 100%;
                left: 5%;
                right: 5%;
                display: flex;
                flex-direction: column;
                align-items: stretch;
                gap: 5px;
                padding: 18px;
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: 10px;
                box-shadow: var(--shadow);
            }

            .nav-links.show a {
                padding: 10px;
            }

            .menu-toggle {
                display: flex;
            }

            .chapter,
            .book-header {
                padding: 24px;
            }

        }

        @media (max-width: 540px) {

            .navbar {
                min-height: 72px;
                padding: 12px 4%;
            }

            .logo {
                font-size: 20px;
            }

            .site-logo {
                width: 35px;
                height: 35px;
            }

            .layout {
                margin-top: 20px;
                padding: 0 14px;
            }

            .reading-controls {
                gap: 14px;
            }

            .control-group {
                width: 100%;
                justify-content: space-between;
            }

            .control-group select {
                min-width: 150px;
            }

            .chapter,
            .book-header {
                padding: 20px;
            }

            .chapter h2 {
                font-size: 1.4em;
            }

        }

