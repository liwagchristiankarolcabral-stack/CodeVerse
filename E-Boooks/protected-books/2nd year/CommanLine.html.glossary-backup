            /* QUIZ STATE */

            let submitted = false;

            /* LOAD QUIZ */

            function loadQuiz() {
                submitted = false;
                quizContainer.innerHTML = "";

                questions.forEach(function (item, index) {
                    const questionBox = document.createElement("div");
                    questionBox.className = "quiz-question";
                    questionBox.id = "question-" + index;

                    const heading = document.createElement("h3");
                    heading.textContent = `${index + 1}. ${item.question}`;
                    questionBox.appendChild(heading);

                    item.options.forEach(function (option, optionIndex) {
                        const label = document.createElement("label");
                        label.className = "quiz-option";

                        const radio = document.createElement("input");
                        radio.type = "radio";
                        radio.name = "question-" + index;
                        radio.value = String(optionIndex);

                        const text = document.createElement("span");
                        text.textContent =
                            String.fromCharCode(65 + optionIndex) +
                            ". " + option;

                        label.appendChild(radio);
                        label.appendChild(text);
                        questionBox.appendChild(label);
                    });

                    const feedback = document.createElement("p");
                    feedback.className = "quiz-feedback";
                    feedback.hidden = true;
                    questionBox.appendChild(feedback);

                    quizContainer.appendChild(questionBox);
                });

                quizResult.hidden = true;
                quizResult.replaceChildren();
                quizResult.classList.remove("passed", "failed");

                submitQuiz.hidden = false;
                retryQuiz.hidden = true;

                updateProgress();
            }

            /* UPDATE PROGRESS */

            function updateProgress() {
                let answered = 0;

                questions.forEach(function (item, index) {
                    const selected = document.querySelector(
                        `input[name="question-${index}"]:checked`
                    );

                    if (selected) answered++;
                });

                quizProgress.textContent =
                    `${answered} of ${questions.length} answered`;
            }

            quizContainer.addEventListener("change", updateProgress);

            /* SUBMIT QUIZ */

            submitQuiz.addEventListener("click", function () {
                if (submitted) return;

                let score = 0;
                let firstUnanswered = -1;

                questions.forEach(function (item, index) {
                    const selected = document.querySelector(
                        `input[name="question-${index}"]:checked`
                    );

                    if (!selected && firstUnanswered === -1) {
                        firstUnanswered = index;
                    }
                });

                if (firstUnanswered !== -1) {
                    alert("Please answer all 30 questions before submitting.");

                    document.getElementById(
                        "question-" + firstUnanswered
                    ).scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });

                    return;
                }

                submitted = true;

                questions.forEach(function (item, index) {
                    const selected = document.querySelector(
                        `input[name="question-${index}"]:checked`
                    );

                    const selectedAnswer = Number(selected.value);
                    const questionBox = document.getElementById(
                        "question-" + index
                    );

                    if (selectedAnswer === item.answer) {
                        score++;
                    }

                    const labels = questionBox.querySelectorAll(".quiz-option");

                    labels.forEach(function (label, optionIndex) {
                        const radio = label.querySelector("input");
                        radio.disabled = true;

                        if (optionIndex === item.answer) {
                            label.classList.add("correct");
                        } else if (optionIndex === selectedAnswer) {
                            label.classList.add("incorrect");
                        }
                    });

                    const feedback = questionBox.querySelector(".quiz-feedback");
                    feedback.hidden = false;

                    feedback.textContent =
                        selectedAnswer === item.answer
                            ? "Correct answer!"
                            : "Correct answer: " + item.options[item.answer];
                });

                /* CALCULATE RESULTS */

                const percentage = (score / questions.length) * 100;
                const minimumScore = Math.ceil(questions.length * 0.75);
                const passed = score >= minimumScore;

                const heading = document.createElement("h3");
                heading.textContent = passed
                    ? "Congratulations! You Passed!"
                    : "Quiz Not Passed";

                const scoreText = document.createElement("h2");
                scoreText.textContent = `${score} / ${questions.length}`;

                const percentageText = document.createElement("p");
                percentageText.textContent = `${percentage.toFixed(2)}%`;

                const passingText = document.createElement("p");
                passingText.textContent =
                    `Passing Score: ${minimumScore} / ${questions.length}`;

                const messageText = document.createElement("p");
                messageText.textContent = passed
                    ? "Excellent work! You successfully completed the assessment."
                    : "Review your incorrect answers and try again.";

                quizResult.replaceChildren(
                    heading,
                    scoreText,
                    percentageText,
                    passingText,
                    messageText
                );

                quizResult.classList.add(passed ? "passed" : "failed");
                quizResult.hidden = false;

                submitQuiz.hidden = true;
                retryQuiz.hidden = false;

                quizResult.scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });
            });

            /* RETRY QUIZ */

            retryQuiz.addEventListener("click", function () {
                loadQuiz();

                document.getElementById("quiz").scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });
            });

            /* INITIALIZE */

            loadQuiz();

        });
