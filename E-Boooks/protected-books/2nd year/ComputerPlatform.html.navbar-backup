        /* =====================================
           QUIZ ELEMENTS
        ====================================== */

        const quizForm =
            document.getElementById("quizForm");

        const quizQuestions =
            document.getElementById("quizQuestions");

        const quizResult =
            document.getElementById("quizResult");

        const resultHeading =
            document.getElementById("resultHeading");

        const resultScore =
            document.getElementById("resultScore");

        const resultPercentage =
            document.getElementById("resultPercentage");

        const resultMessage =
            document.getElementById("resultMessage");

        const submitQuiz =
            document.getElementById("submitQuiz");

        const resetQuiz =
            document.getElementById("resetQuiz");

        let quizSubmitted = false;

        /* =====================================
           RENDER QUIZ QUESTIONS
        ====================================== */

        function renderQuiz() {

            quizQuestions.innerHTML = "";

            quizData.forEach((item, index) => {

                const questionNumber = index + 1;

                const questionBox =
                    document.createElement("div");

                questionBox.className = "quiz-question";

                questionBox.id =
                    "quiz-question-" + questionNumber;

                const heading =
                    document.createElement("h3");

                heading.textContent =
                    questionNumber + ". " + item.question;

                questionBox.appendChild(heading);

                item.options.forEach((option, optionIndex) => {

                    const label =
                        document.createElement("label");

                    label.className = "quiz-option";

                    const input =
                        document.createElement("input");

                    input.type = "radio";

                    input.name =
                        "question-" + index;

                    input.value =
                        String(optionIndex);

                    input.required = true;

                    const optionText =
                        document.createElement("span");

                    optionText.textContent =
                        String.fromCharCode(65 + optionIndex) +
                        ". " + option;

                    label.appendChild(input);

                    label.appendChild(optionText);

                    questionBox.appendChild(label);

                });

                const feedback =
                    document.createElement("p");

                feedback.className = "quiz-feedback";

                feedback.hidden = true;

                feedback.id =
                    "feedback-" + index;

                questionBox.appendChild(feedback);

                quizQuestions.appendChild(questionBox);

            });

            quizSubmitted = false;

            submitQuiz.disabled = false;

            submitQuiz.textContent = "Submit Quiz";

            quizResult.hidden = true;

        }

        /* =====================================
           SUBMIT AND GRADE QUIZ
        ====================================== */

        quizForm.addEventListener("submit", function (event) {

            event.preventDefault();

            if (quizSubmitted) {
                return;
            }

            let score = 0;

            let firstUnanswered = null;

            const selectedAnswers = [];

            quizData.forEach((item, index) => {

                const selected =
                    quizForm.querySelector(
                        'input[name="question-' +
                        index +
                        '"]:checked'
                    );

                if (!selected) {

                    if (!firstUnanswered) {

                        firstUnanswered =
                            document.getElementById(
                                "quiz-question-" + (index + 1)
                            );

                    }

                    selectedAnswers.push(null);

                } else {

                    selectedAnswers.push(
                        Number(selected.value)
                    );

                }

            });

            if (firstUnanswered) {

                alert(
                    "Please answer all 30 questions before submitting."
                );

                firstUnanswered.scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });

                const firstInput =
                    firstUnanswered.querySelector(
                        'input[type="radio"]'
                    );

                if (firstInput) {
                    firstInput.focus({
                        preventScroll: true
                    });
                }

                return;
            }

            quizData.forEach((item, index) => {

                const selectedIndex =
                    selectedAnswers[index];

                const questionBox =
                    document.getElementById(
                        "quiz-question-" + (index + 1)
                    );

                const labels =
                    questionBox.querySelectorAll(
                        ".quiz-option"
                    );

                const feedback =
                    document.getElementById(
                        "feedback-" + index
                    );

                if (selectedIndex === item.correct) {

                    score++;

                }

                labels.forEach((label, optionIndex) => {

                    if (optionIndex === item.correct) {

                        label.classList.add("correct");

                    }

                    if (
                        optionIndex === selectedIndex &&
                        selectedIndex !== item.correct
                    ) {

                        label.classList.add("incorrect");

                    }

                });

                const correctLetter =
                    String.fromCharCode(
                        65 + item.correct
                    );

                feedback.textContent =
                    "Correct Answer: " +
                    correctLetter +
                    ". " +
                    item.options[item.correct] +
                    " — " +
                    item.explanation;

                feedback.hidden = false;

            });

            const total = quizData.length;

            const percentage =
                (score / total) * 100;

            const passed =
                percentage >= 75;

            resultHeading.textContent =
                passed
                    ? "Congratulations! You Passed!"
                    : "Assessment Not Passed";

            resultScore.textContent =
                "Your Score: " +
                score +
                " / " +
                total;

            resultPercentage.textContent =
                "Percentage: " +
                percentage.toFixed(2) +
                "%";

            resultMessage.textContent =
                passed
                    ? "You have successfully passed the Computer System Platforms and Architecture assessment."
                    : "You need at least 75% (23 correct answers) to pass. Review the lessons and try again.";

            quizResult.hidden = false;

            quizSubmitted = true;

            submitQuiz.disabled = true;

            submitQuiz.textContent =
                "Assessment Submitted";

            quizForm.querySelectorAll(
                'input[type="radio"]'
            ).forEach(input => {

                input.disabled = true;

            });

            quizResult.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });

        });

        /* =====================================
           RESET QUIZ
        ====================================== */

        resetQuiz.addEventListener("click", function () {

            quizForm.reset();

            renderQuiz();

            document.getElementById("quiz").scrollIntoView({
                behavior: "smooth",
                block: "start"
            });

        });

        /* =====================================
           INITIALIZE QUIZ
        ====================================== */

        renderQuiz();

    </script>
