                    question: "Which technology supports very short-range communication?",
                    options: [
                        "4G LTE",
                        "Wi-Fi",
                        "NFC",
                        "GPS"
                    ],
                    answer: 2
                },
                {
                    question: "What is the main goal of mobile application security?",
                    options: [
                        "Increase battery consumption",
                        "Remove all permissions",
                        "Prevent application updates",
                        "Protect applications and user information"
                    ],
                    answer: 3
                },
                {
                    question: "Which permission allows an application to capture images?",
                    options: [
                        "Camera",
                        "Contacts",
                        "Location",
                        "Notifications"
                    ],
                    answer: 0
                },
                {
                    question: "What is a cloud-based mobile application?",
                    options: [
                        "An application without any data",
                        "An app using remote servers for data or services",
                        "An application that cannot connect to networks",
                        "A hardware-only device"
                    ],
                    answer: 1
                },
                {
                    question: "Which is a lightweight relational database engine?",
                    options: [
                        "Bluetooth",
                        "Android Studio",
                        "SQLite",
                        "Xcode"
                    ],
                    answer: 2
                },
                {
                    question: "What does MDM stand for?",
                    options: [
                        "Mobile Data Memory",
                        "Main Device Monitor",
                        "Multiple Disk Management",
                        "Mobile Device Management"
                    ],
                    answer: 3
                },
                {
                    question: "Which is an educational use of mobile platforms?",
                    options: [
                        "Reading electronic books",
                        "Disabling communication",
                        "Removing all applications",
                        "Preventing online lessons"
                    ],
                    answer: 0
                },
                {
                    question: "Which is a future trend in mobile technology?",
                    options: [
                        "Eliminating wireless communication",
                        "Artificial intelligence integration",
                        "Removing application security",
                        "Stopping cloud services"
                    ],
                    answer: 1
                }
            ];
    const quizQuestions = $("quizQuestions"), quizProgress = $("quizProgress");
    const progressFill = $("progressFill"), progressBar = $("quizProgressBar");
    const submitQuiz = $("submitQuiz"), retryQuiz = $("retryQuiz"), quizResult = $("quizResult");
    const passingScore = Math.ceil(questions.length * .75);
    let submitted = false;
    function updateProgress() {
        const count = questions.reduce((n, q, i) => n + Number(!!quizQuestions.querySelector(`input[name="question${i}"]:checked`)), 0);
        quizProgress.textContent = `${count} of ${questions.length} answered`;
        progressFill.style.width = `${count / questions.length * 100}%`;
        progressBar.setAttribute("aria-valuenow", String(count));
    }
    function loadQuiz() {
        submitted = false;
        quizQuestions.replaceChildren();
        quizResult.replaceChildren(); quizResult.hidden = true;
        quizResult.className = "quiz-result";
        submitQuiz.hidden = false; retryQuiz.hidden = true;
        questions.forEach((item, index) => {
            const box = document.createElement("div"); box.className = "quiz-question";
            const heading = document.createElement("h3"); heading.textContent = `${index + 1}. ${item.question}`;
            box.appendChild(heading);
            item.options.forEach((option, optionIndex) => {
                const label = document.createElement("label"); label.className = "quiz-option";
                const radio = document.createElement("input"); radio.type = "radio"; radio.name = `question${index}`;
                radio.value = String(optionIndex); radio.required = true;
                const span = document.createElement("span"); span.textContent = `${String.fromCharCode(65 + optionIndex)}. ${option}`;
                label.append(radio, span); box.appendChild(label);
            });
            const feedback = document.createElement("p"); feedback.className = "quiz-feedback"; feedback.hidden = true;
            box.appendChild(feedback); quizQuestions.appendChild(box);
        });
        updateProgress();
    }
    quizQuestions.addEventListener("change", () => { if (!submitted) updateProgress(); });
    submitQuiz.addEventListener("click", () => {
        if (submitted) return;
        const answers = questions.map((q, i) => {
            const radio = quizQuestions.querySelector(`input[name="question${i}"]:checked`);
            return radio ? Number(radio.value) : null;
        });
        const missing = answers.findIndex(a => a === null);
        if (missing !== -1) {
            const remaining = answers.filter(a => a === null).length;
            quizResult.hidden = false; quizResult.className = "quiz-result";
            quizResult.textContent = `Please answer all 30 questions. ${remaining} question(s) remaining.`;
            const box = quizQuestions.children[missing];
            box.scrollIntoView({behavior: "smooth", block: "center"});
            box.querySelector("input")?.focus({preventScroll: true});
            return;
        }
        submitted = true;
        let score = 0;
        questions.forEach((item, i) => {
            const box = quizQuestions.children[i], selected = answers[i];
            const correct = selected === item.answer;
            if (correct) score++;
            box.querySelectorAll(".quiz-option").forEach((label, j) => {
                label.querySelector("input").disabled = true;
                if (j === item.answer) label.classList.add("correct");
                else if (j === selected) label.classList.add("incorrect");
            });
            const feedback = box.querySelector(".quiz-feedback");
            feedback.hidden = false;
            feedback.classList.add(correct ? "correct" : "incorrect");
            feedback.textContent = correct
                ? `Correct! ${item.options[item.answer]}`
                : `Incorrect. Correct answer: ${String.fromCharCode(65 + item.answer)}. ${item.options[item.answer]}`;
        });
        const passed = score >= passingScore;
        quizResult.className = `quiz-result ${passed ? "passed" : "failed"}`;
        quizResult.replaceChildren();
        const heading = document.createElement("h3"); heading.textContent = passed ? "Congratulations! You Passed!" : "Assessment Not Passed";
        const details = document.createElement("p");
        details.textContent = `Score: ${score}/${questions.length} (${(score / questions.length * 100).toFixed(2)}%). Passing score: ${passingScore}/${questions.length} (75%).`;
        const message = document.createElement("p");
        message.textContent = passed ? "You successfully completed the assessment." : "Review the highlighted answers and try again.";
        quizResult.append(heading, details, message); quizResult.hidden = false;
        submitQuiz.hidden = true; retryQuiz.hidden = false;
        quizResult.scrollIntoView({behavior: "smooth", block: "center"});
    });
    retryQuiz.addEventListener("click", () => {
        loadQuiz();
        $("quiz").scrollIntoView({behavior: "smooth", block: "start"});
    });
    loadQuiz();
});
</script>
