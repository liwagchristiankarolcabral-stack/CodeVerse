            submitQuiz.disabled = false;

            submitQuiz.textContent = "Submit Quiz";

            quizResult.hidden = true;

            updateQuizProgress();

        }

        /* =====================================
           QUIZ PROGRESS TRACKING
        ====================================== */

        function updateQuizProgress() {

            let answered = 0;

            quizData.forEach((item, index) => {

                const selected =
                    quizForm.querySelector(
                        'input[name="question-' +
                        index +
                        '"]:checked'
                    );

                if (selected) {
                    answered++;
                }

            });

            quizProgress.textContent =
                "Questions Answered: " +
                answered +
                " / " +
                quizData.length;

        }

        quizForm.addEventListener("change", function () {

            if (!quizSubmitted) {
                updateQuizProgress();
            }

        });

        /* =====================================
           SUBMIT AND GRADE QUIZ
        ====================================== */

        quizForm.addEventListener("submit", function (event) {

            event.preventDefault();

            if (quizSubmitted) {
                return;
            }

            let score = 0;

            let firstUnanswered = null;

            const selectedAnswers = [];

            quizData.forEach((item, index) => {

                const selected =
                    quizForm.querySelector(
                        'input[name="question-' +
                        index +
                        '"]:checked'
                    );

                if (!selected) {

                    if (!firstUnanswered) {

                        firstUnanswered =
                            document.getElementById(
                                "quiz-question-" + (index + 1)
                            );

                    }

                    selectedAnswers.push(null);

                } else {

                    selectedAnswers.push(
                        Number(selected.value)
                    );

                }

            });

            if (firstUnanswered) {

                alert(
                    "Please answer all 30 questions before submitting."
                );

                firstUnanswered.scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });

                const firstInput =
                    firstUnanswered.querySelector(
                        'input[type="radio"]'
                    );

                if (firstInput) {

                    firstInput.focus({
                        preventScroll: true
                    });

                }

                return;
            }

            quizData.forEach((item, index) => {

                const selectedIndex =
                    selectedAnswers[index];

                const questionBox =
                    document.getElementById(
                        "quiz-question-" + (index + 1)
                    );

                const labels =
                    questionBox.querySelectorAll(
                        ".quiz-option"
                    );

                const feedback =
                    document.getElementById(
                        "feedback-" + index
                    );

                if (selectedIndex === item.correct) {

                    score++;

                }

                labels.forEach((label, optionIndex) => {

                    if (optionIndex === item.correct) {

                        label.classList.add("correct");

                    }

                    if (
                        optionIndex === selectedIndex &&
                        selectedIndex !== item.correct
                    ) {

                        label.classList.add("incorrect");

                    }

                });

                const correctLetter =
                    String.fromCharCode(
                        65 + item.correct
                    );

                feedback.textContent =
                    "Correct Answer: " +
                    correctLetter +
                    ". " +
                    item.options[item.correct] +
                    " — " +
                    item.explanation;

                feedback.hidden = false;

            });

            const total = quizData.length;

            const percentage =
                (score / total) * 100;

            const passed =
                percentage >= 75;

            resultHeading.textContent =
                passed
                    ? "Congratulations! You Passed!"
                    : "Assessment Not Passed";

            resultScore.textContent =
                "Your Score: " +
                score +
                " / " +
                total;

            resultPercentage.textContent =
                "Percentage: " +
                percentage.toFixed(2) +
                "%";

            resultMessage.textContent =
                passed
                    ? "You have successfully passed the Deadlocks and Resource Allocation assessment."
                    : "You need at least 75% (23 correct answers) to pass. Review the chapters and try again.";

            quizResult.hidden = false;

            quizSubmitted = true;

            submitQuiz.disabled = true;

            submitQuiz.textContent =
                "Assessment Submitted";

            quizForm.querySelectorAll(
                'input[type="radio"]'
            ).forEach(input => {

                input.disabled = true;

            });

            quizResult.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });

        });

        /* =====================================
           RESET QUIZ
        ====================================== */

        resetQuiz.addEventListener("click", function () {

            quizForm.reset();

            renderQuiz();

            document.getElementById("quiz").scrollIntoView({
                behavior: "smooth",
                block: "start"
            });

        });

        /* =====================================
           INITIALIZE QUIZ
        ====================================== */

        renderQuiz();

    </script>
</body>
</html>
