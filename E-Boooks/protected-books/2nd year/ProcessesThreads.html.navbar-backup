<script>
/* ==========================================
   QUIZ ELEMENTS
========================================== */

const quizForm = document.getElementById("quizForm");
const quizContainer = document.getElementById("quizContainer");
const quizResult = document.getElementById("quizResult");
const quizProgress = document.getElementById("quizProgress");
const progressFill = document.getElementById("progressFill");
const submitQuiz = document.getElementById("submitQuiz");
const retryQuiz = document.getElementById("retryQuiz");

let quizSubmitted = false;

/* ==========================================
   RENDER QUIZ
========================================== */

function renderQuiz() {
    quizContainer.innerHTML = "";
    quizSubmitted = false;

    quizQuestions.forEach(function (item, index) {
        const questionBox = document.createElement("div");

        questionBox.className = "quiz-question";
        questionBox.id = "question-" + index;

        const questionTitle = document.createElement("h3");

        questionTitle.textContent =
            (index + 1) + ". " + item.question;

        questionBox.appendChild(questionTitle);

        item.options.forEach(function (option, optionIndex) {
            const label = document.createElement("label");
            const radio = document.createElement("input");

            radio.type = "radio";
            radio.name = "question" + index;
            radio.value = String(optionIndex);

            radio.addEventListener("change", updateProgress);

            label.appendChild(radio);
            label.appendChild(document.createTextNode(option));

            questionBox.appendChild(label);
        });

        quizContainer.appendChild(questionBox);
    });

    quizResult.style.display = "none";
    quizResult.innerHTML = "";

    submitQuiz.style.display = "inline-block";
    retryQuiz.style.display = "none";

    updateProgress();
}

/* ==========================================
   UPDATE QUIZ PROGRESS
========================================== */

function updateProgress() {
    let answered = 0;

    quizQuestions.forEach(function (item, index) {
        const selected = quizForm.querySelector(
            'input[name="question' + index + '"]:checked'
        );

        if (selected) {
            answered++;
        }
    });

    quizProgress.textContent =
        "Answered " + answered +
        " of " + quizQuestions.length + " questions";

    const percentage =
        (answered / quizQuestions.length) * 100;

    progressFill.style.width = percentage + "%";
}

/* ==========================================
   SUBMIT QUIZ
========================================== */

quizForm.addEventListener("submit", function (event) {
    event.preventDefault();

    if (quizSubmitted) return;

    let score = 0;
    let answered = 0;
    let firstUnanswered = null;

    quizQuestions.forEach(function (item, index) {
        const selected = quizForm.querySelector(
            'input[name="question' + index + '"]:checked'
        );

        if (selected) {
            answered++;
        } else if (firstUnanswered === null) {
            firstUnanswered = index;
        }
    });

    if (answered !== quizQuestions.length) {
        quizResult.style.display = "block";

        quizResult.textContent =
            "Please answer all questions before submitting. " +
            "You have answered " + answered +
            " out of " + quizQuestions.length + ".";

        if (firstUnanswered !== null) {
            document.getElementById(
                "question-" + firstUnanswered
            ).scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
        }

        return;
    }

    quizSubmitted = true;

    quizQuestions.forEach(function (item, index) {
        const questionBox = document.getElementById(
            "question-" + index
        );

        const selected = quizForm.querySelector(
            'input[name="question' + index + '"]:checked'
        );

        const selectedAnswer = Number(selected.value);

        questionBox.classList.remove(
            "correct",
            "incorrect"
        );

        if (selectedAnswer === item.answer) {
            score++;
            questionBox.classList.add("correct");
        } else {
            questionBox.classList.add("incorrect");
        }

        const correctAnswer = document.createElement("p");

        correctAnswer.style.fontWeight = "700";
        correctAnswer.style.fontSize = "14px";

        correctAnswer.textContent =
            "Correct Answer: " +
            item.options[item.answer];

        questionBox.appendChild(correctAnswer);

        questionBox.querySelectorAll(
            'input[type="radio"]'
        ).forEach(function (radio) {
            radio.disabled = true;
        });
    });

    const percentage = Math.round(
        (score / quizQuestions.length) * 100
    );

    const passed = percentage >= 75;

    quizResult.style.display = "block";
    quizResult.innerHTML = "";

    const heading = document.createElement("h3");
    heading.textContent = passed
        ? "Congratulations! You Passed!"
        : "Keep Learning!";

    const scoreText = document.createElement("p");
    scoreText.textContent =
        "Your Score: " + score +
        " / " + quizQuestions.length;

    const percentageText = document.createElement("p");
    percentageText.textContent =
        "Percentage: " + percentage + "%";

    const statusText = document.createElement("p");
    statusText.textContent =
        "Result: " + (passed ? "PASSED" : "FAILED");

    statusText.style.fontWeight = "800";
    statusText.style.color = passed
        ? "#26a269"
        : "#d35b5b";

    quizResult.appendChild(heading);
    quizResult.appendChild(scoreText);
    quizResult.appendChild(percentageText);
    quizResult.appendChild(statusText);

    submitQuiz.style.display = "none";
    retryQuiz.style.display = "inline-block";

    quizResult.scrollIntoView({
        behavior: "smooth",
        block: "center"
    });
});

/* ==========================================
   RETRY QUIZ
========================================== */

retryQuiz.addEventListener("click", function () {
    renderQuiz();

    document.getElementById("quiz").scrollIntoView({
        behavior: "smooth",
        block: "start"
    });
});

/* ==========================================
   INITIALIZE QUIZ
========================================== */

renderQuiz();

</script>
