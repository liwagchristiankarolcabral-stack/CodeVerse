<style>
        /* ==========================================
           CODEVERSE E-BOOK READER
           PROCESSES, THREADS AND SCHEDULING
        ========================================== */

        :root {
            --primary: #3157a4;
            --primary-dark: #24427f;
            --background: #f7f9fd;
            --surface: #ffffff;
            --text: #202b40;
            --muted: #758096;
            --border: #e6eaf1;
            --shadow: 0 8px 30px rgba(30, 50, 90, .07);
            --reader-size: 16px;
            --reader-family: 'DM Sans', sans-serif;
        }

        body.dark-mode {
            --primary: #91b4ff;
            --primary-dark: #b8ceff;
            --background: #101827;
            --surface: #1b273a;
            --text: #eaf0fb;
            --muted: #a4b2c9;
            --border: #34435a;
            --shadow: 0 8px 30px rgba(0, 0, 0, .2);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 105px;
        }

        body {
            margin: 0;
            background: var(--background);
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            transition: background .3s, color .3s;
        }

        a {
            color: var(--primary);
        }

        button,
        select {
            font-family: inherit;
        }

        button {
            cursor: pointer;
        }

        /* ==========================================
           NAVIGATION BAR
        ========================================== */

        .navbar {
            min-height: 82px;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            padding: 12px 5%;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 11px;
            text-decoration: none;
            color: var(--text);
            font-size: 23px;
            font-weight: 800;
            white-space: nowrap;
        }

        .site-logo {
            width: 43px;
            height: 43px;
            object-fit: contain;
        }

        .logo-highlight {
            color: var(--primary);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .nav-links a {
            color: var(--text);
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            transition: color .2s;
        }

        .nav-links a:hover {
            color: var(--primary);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .nav-actions button {
            background: var(--surface);
            color: var(--text);
            border: 1px solid var(--border);
            border-radius: 9px;
            padding: 10px 13px;
            font-size: 13px;
            font-weight: 700;
        }

        .nav-actions button:hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        #accountActions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .login-btn,
        .signup-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 11px 16px;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
        }

        .login-btn {
            color: var(--primary);
            border: 1px solid var(--primary);
        }

        .signup-btn {
            color: #ffffff;
            background: #3157a4;
            border: 1px solid #3157a4;
        }

        .signup-btn:hover {
            background: #24427f;
        }

        .menu-toggle {
            display: none;
        }

        /* ==========================================
           BACK NAVIGATION
        ========================================== */

        .topbar {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 13px 5%;
        }

        .back-link {
            color: var(--primary);
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        /* ==========================================
           READING CONTROLS
        ========================================== */

        .reading-controls {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 18px;
            padding: 17px 20px;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
        }

        .control-group {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .control-group label {
            color: var(--muted);
            font-size: 13px;
            font-weight: 700;
        }

        .control-group select {
            background: var(--background);
            color: var(--text);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 9px 12px;
            font-size: 13px;
            cursor: pointer;
        }

        /* ==========================================
           READER LAYOUT
        ========================================== */

        .reader-layout {
            display: grid;
            grid-template-columns: 290px minmax(0, 1fr);
            max-width: 1600px;
            margin: auto;
        }

        /* ==========================================
           SIDEBAR AND TABLE OF CONTENTS
        ========================================== */

        .sidebar {
            height: calc(100vh - 82px);
            position: sticky;
            top: 82px;
            overflow-y: auto;
            background: var(--surface);
            border-right: 1px solid var(--border);
            padding: 25px 15px;
            scrollbar-width: thin;
            scrollbar-color: var(--border) transparent;
        }

        .sidebar h3 {
            color: var(--muted);
            font-size: 11px;
            letter-spacing: 1px;
            padding: 0 12px;
            margin: 23px 0 10px;
        }

        .sidebar a {
            display: block;
            padding: 10px 12px;
            margin-bottom: 3px;
            border-radius: 9px;
            text-decoration: none;
            color: var(--text);
            font-size: 13px;
            line-height: 1.5;
            transition: background .2s, color .2s;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: var(--background);
            color: var(--primary);
        }

        .sidebar a.active {
            font-weight: 800;
        }

        /* ==========================================
           MAIN READER
        ========================================== */

        .reader {
            padding: 35px;
            max-width: 1100px;
            width: 100%;
            min-width: 0;
            margin: auto;
        }

        /* ==========================================
           HERO SECTION
        ========================================== */

        .hero {
            background: linear-gradient(
                135deg,
                #254783,
                #547ed0
            );
            color: white;
            border-radius: 20px;
            padding: 55px 40px;
            margin-bottom: 30px;
        }

        .hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(30px, 4vw, 46px);
            line-height: 1.2;
        }

        .hero p {
            line-height: 1.9;
            max-width: 700px;
        }

        /* ==========================================
           CHAPTER SECTIONS
        ========================================== */

        .chapter {
            background: var(--surface);
            padding: 35px;
            border-radius: 16px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            margin-bottom: 25px;
        }

        .chapter-number {
            color: var(--primary);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .chapter h2 {
            font-family: 'Playfair Display', serif;
            font-size: 29px;
            margin: 12px 0 20px;
        }

        .chapter h3 {
            color: var(--primary);
            font-size: 19px;
            margin-top: 28px;
        }

        .chapter p,
        .chapter li {
            font-family: var(--reader-family);
            font-size: var(--reader-size);
            line-height: 1.9;
        }

        .chapter li {
            margin-bottom: 7px;
        }

        .chapter ul,
        .chapter ol {
            padding-left: 25px;
        }

        /* ==========================================
           CODE AND DIAGRAMS
        ========================================== */

        .chapter pre {
            background: var(--background);
            color: var(--text);
            padding: 20px;
            border-radius: 10px;
            overflow-x: auto;
            line-height: 1.7;
            font-size: 14px;
            white-space: pre;
        }

        .chapter pre code {
            font-family: Consolas, monospace;
        }

        /* ==========================================
           TABLES
        ========================================== */

        .table-wrapper {
            overflow-x: auto;
        }

        .chapter table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            font-size: 14px;
        }

        .chapter th,
        .chapter td {
            padding: 13px;
            border: 1px solid var(--border);
            text-align: left;
            line-height: 1.6;
        }

        .chapter th {
            background: var(--background);
            color: var(--text);
        }

        /* ==========================================
           INFORMATION NOTES
        ========================================== */

        .note {
            border-left: 4px solid var(--primary);
            background: var(--background);
            padding: 16px 20px;
            border-radius: 8px;
            margin: 20px 0;
            line-height: 1.8;
        }

        /* ==========================================
           INTERACTIVE QUIZ
        ========================================== */

        .quiz-question {
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 20px;
            margin: 18px 0;
        }

        .quiz-question h3 {
            font-size: 16px;
            color: var(--text);
            margin-top: 0;
        }

        .quiz-question label {
            display: block;
            padding: 11px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            line-height: 1.6;
        }

        .quiz-question label:hover {
            background: var(--background);
        }

        .quiz-question input {
            margin-right: 10px;
            accent-color: #3157a4;
        }

        .quiz-question label.correct {
            background: rgba(38, 162, 105, .12);
            border-radius: 8px;
        }

        .quiz-question label.incorrect {
            background: rgba(211, 91, 91, .12);
            border-radius: 8px;
        }

        .quiz-button {
            padding: 14px 25px;
            background: #3157a4;
            border: none;
            color: white;
            border-radius: 9px;
            font-weight: 700;
            margin: 10px 8px 10px 0;
        }

        .quiz-button:hover {
            background: #24427f;
        }

        .quiz-result {
            padding: 20px;
            border-radius: 10px;
            background: var(--background);
            margin-top: 15px;
            display: none;
        }

        .quiz-question.correct {
            border-color: #26a269;
        }

        .quiz-question.incorrect {
            border-color: #d35b5b;
        }

        .quiz-feedback {
            font-weight: 700;
            color: var(--primary);
        }

        .quiz-progress {
            font-size: 14px;
            color: var(--muted);
        }

        .progress-track {
            height: 8px;
            background: var(--border);
            border-radius: 20px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            width: 0;
            background: #3157a4;
            transition: width .2s;
        }

        /* ==========================================
           FOOTER
        ========================================== */

        .footer {
            text-align: center;
            color: var(--muted);
            padding: 30px;
            font-size: 13px;
        }

        /* ==========================================
           RESPONSIVE NAVIGATION
        ========================================== */

        @media (max-width: 1100px) {

            .navbar {
                flex-wrap: wrap;
            }

            .nav-links {
                gap: 15px;
            }

        }

        @media (max-width: 950px) {

            .menu-toggle {
                display: inline-flex;
            }

            .nav-links {
                display: none;
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                background: var(--surface);
                border-bottom: 1px solid var(--border);
                padding: 20px;
                flex-direction: column;
                align-items: flex-start;
            }

            .nav-links.show {
                display: flex;
            }

            .reader-layout {
                display: block;
            }

            .sidebar {
                display: none;
                position: fixed;
                top: 82px;
                left: 0;
                width: min(330px, 90vw);
                height: calc(100vh - 82px);
                z-index: 999;
                box-shadow: var(--shadow);
            }

            .sidebar.show {
                display: block;
            }

            .reader {
                padding: 20px;
            }

        }

        @media (max-width: 600px) {

            .navbar {
                padding: 12px 15px;
                gap: 10px;
            }

            .logo {
                font-size: 19px;
            }

            .site-logo {
                width: 35px;
                height: 35px;
            }

            .nav-actions {
                gap: 5px;
            }

            .nav-actions button {
                padding: 9px;
                font-size: 12px;
            }

            .login-btn,
            .signup-btn {
                padding: 9px;
                font-size: 12px;
            }

            .reading-controls {
                justify-content: flex-start;
            }

            .reader {
                padding: 15px;
            }

            .chapter {
                padding: 23px;
            }

            .hero {
                padding: 30px 25px;
            }

        }

        @media (max-width: 420px) {

            .navbar {
                justify-content: center;
            }

            .nav-actions {
                flex-wrap: wrap;
                justify-content: center;
            }

        }

    </style>
