========================================== */

document.addEventListener("DOMContentLoaded", function () {

    const quizQuestions = document.getElementById("quizQuestions");
    const submitQuiz = document.getElementById("submitQuiz");
    const retryQuiz = document.getElementById("retryQuiz");
    const quizResult = document.getElementById("quizResult");
    const quizProgress = document.getElementById("quizProgress");

    if (!quizQuestions || !submitQuiz || !retryQuiz ||
        !quizResult || !quizProgress) {
        console.error("JavaScript quiz elements not found.");
        return;
    }

    /* ==========================================
       QUIZ QUESTIONS
    ========================================== */

    const questions = [
        {
            question: "What is the primary purpose of JavaScript in web development?",
            options: [
                "To define the structure of webpages",
                "To add interactivity and dynamic behavior",
                "To control only the colors and fonts",
                "To replace HTML and CSS completely"
            ],
            answer: 1
        },
        {
            question: "Which JavaScript keyword declares a variable that can be reassigned?",
            options: [
                "const",
                "static",
                "let",
                "define"
            ],
            answer: 2
        },
        {
            question: "Which method is used to respond to a user's click on an HTML button?",
            options: [
                "addEventListener()",
                "createElement()",
                "querySelector()",
                "appendChild()"
            ],
            answer: 0
        },
        {
            question: "What does DOM stand for?",
            options: [
                "Digital Object Management",
                "Document Operation Method",
                "Data Organization Model",
                "Document Object Model"
            ],
            answer: 3
        },
        {
            question: "Which JavaScript method selects the first HTML element matching a CSS selector?",
            options: [
                "document.createElement()",
                "document.querySelector()",
                "document.appendChild()",
                "document.remove()"
            ],
            answer: 1
        },
        {
            question: "Which property changes the text inside an HTML element?",
            options: [
                "textContent",
                "classList",
                "innerWidth",
                "nodeName"
            ],
            answer: 0
        },
        {
            question: "Which method creates a new HTML element using JavaScript?",
            options: [
                "querySelectorAll()",
                "getElementById()",
                "createElement()",
                "removeChild()"
            ],
            answer: 2
        },
        {
            question: "What is the purpose of the defer attribute in a classic external JavaScript script?",
            options: [
                "To permanently disable JavaScript execution",
                "To execute the script before HTML parsing starts",
                "To remove the need for a JavaScript file",
                "To execute the script after HTML parsing finishes"
            ],
            answer: 3
        },
        {
            question: "Which JavaScript method removes an existing HTML element from the DOM?",
            options: [
                "appendChild()",
                "remove()",
                "createElement()",
                "querySelector()"
            ],
            answer: 1
        },
        {
            question: "What does event.preventDefault() do when used in a form submission handler?",
            options: [
                "Deletes all form fields",
                "Automatically submits the form to a database",
                "Prevents the browser's default form submission action",
                "Disables every event listener on the page"
            ],
            answer: 2
        }
    ];

    let quizSubmitted = false;

    /* ==========================================
       LOAD QUIZ
    ========================================== */

    function loadQuiz() {

        quizSubmitted = false;
        quizQuestions.innerHTML = "";

        questions.forEach((item, index) => {

            const box = document.createElement("div");
            box.className = "quiz-question";

            const heading = document.createElement("h3");
            heading.textContent = `${index + 1}. ${item.question}`;

            box.appendChild(heading);

            item.options.forEach((option, optionIndex) => {

                const label = document.createElement("label");
                label.className = "quiz-option";

                const radio = document.createElement("input");
                radio.type = "radio";
                radio.name = `question${index}`;
                radio.value = String(optionIndex);

                radio.addEventListener("change", updateProgress);

                const span = document.createElement("span");
                span.textContent = option;

                label.append(radio, span);
                box.appendChild(label);

            });

            quizQuestions.appendChild(box);

        });

        quizResult.hidden = true;
        quizResult.innerHTML = "";

        retryQuiz.hidden = true;
        submitQuiz.hidden = false;
        submitQuiz.disabled = false;

        updateProgress();
    }

    /* ==========================================
       UPDATE PROGRESS
    ========================================== */

    function updateProgress() {

        let answered = 0;

        questions.forEach((item, index) => {

            const selected = quizQuestions.querySelector(
                `input[name="question${index}"]:checked`
            );

            if (selected) {
                answered++;
            }

        });

        quizProgress.textContent =
            `${answered} of ${questions.length} answered`;
    }

    /* ==========================================
       SUBMIT QUIZ
    ========================================== */

    submitQuiz.addEventListener("click", async function () {

        if (quizSubmitted) return;

        const selections = questions.map((item, index) => {

            const selected = quizQuestions.querySelector(
                `input[name="question${index}"]:checked`
            );

            return selected ? Number(selected.value) : null;

        });

        if (selections.includes(null)) {

            alert("Please answer all questions before submitting.");
            return;

        }

        quizSubmitted = true;
        submitQuiz.disabled = true;

        let score = 0;

        /* ==========================================
           CHECK ANSWERS
        ========================================== */

        questions.forEach((item, index) => {

            const box = quizQuestions.children[index];
            const selectedAnswer = selections[index];

            if (selectedAnswer === item.answer) {
                score++;
            }

            box.querySelectorAll(".quiz-option").forEach(
                (label, optionIndex) => {

                    const radio = label.querySelector("input");
                    radio.disabled = true;

                    if (optionIndex === item.answer) {
                        label.classList.add("correct");
                    } else if (optionIndex === selectedAnswer) {
                        label.classList.add("incorrect");
                    }

                }
            );

            const feedback = document.createElement("p");
            feedback.className = "quiz-feedback";

            feedback.textContent =
                selectedAnswer === item.answer
                    ? "Correct answer!"
                    : `Correct answer: ${item.options[item.answer]}`;

            box.appendChild(feedback);

        });

        /* ==========================================
           CALCULATE SCORE
        ========================================== */

        const percentage = Math.round(
            (score / questions.length) * 100
        );

        let message;

        if (percentage >= 90) {
            message = "Excellent work!";
        } else if (percentage >= 75) {
            message = "Great job!";
        } else if (percentage >= 60) {
            message = "Good effort! Keep reviewing.";
        } else {
            message = "Review the chapters and try again.";
        }

        quizResult.innerHTML = `
            <h3>Quiz Completed!</h3>
            <p>Your Score</p>
            <h2>${score} / ${questions.length}</h2>
            <p>${percentage}%</p>
            <strong>${message}</strong>
            <p id="quizSaveStatus" aria-live="polite">
                Saving quiz result...
            </p>
        `;

        quizResult.hidden = false;
        submitQuiz.hidden = true;
        retryQuiz.hidden = false;

        quizResult.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });

        /* ==========================================
           SAVE RESULT TO CODEVERSE DATABASE
        ========================================== */

        const saveStatus = document.getElementById("quizSaveStatus");

        try {

            const response = await fetch("/api/quiz-results", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                credentials: "same-origin",
                body: JSON.stringify({
                    bookId: 6,
                    score: score,
                    totalQuestions: questions.length
                })
            });

            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }

            const data = await response.json();

            saveStatus.textContent = data.success
                ? "Your quiz score has been saved!"
                : (data.message || "Quiz score could not be saved.");

        } catch (error) {

            console.error("Quiz save error:", error);

            saveStatus.textContent =
                "Quiz completed, but the score could not be saved.";

        }

    });

    /* ==========================================
       RETRY QUIZ
    ========================================== */

    retryQuiz.addEventListener("click", function () {

        loadQuiz();

        document.getElementById("quiz").scrollIntoView({
            behavior: "smooth",
            block: "start"
        });

    });

    /* ==========================================
       INITIALIZE
    ========================================== */

    loadQuiz();

});

</script>
