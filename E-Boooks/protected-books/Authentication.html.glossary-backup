<script>
document.addEventListener("DOMContentLoaded", function () {

    "use strict";

    // ==========================================
    // DARK MODE
    // ==========================================

    const themeToggle =
        document.getElementById("themeToggle");

    const themeIcon =
        document.getElementById("themeIcon");

    const savedTheme =
        localStorage.getItem("readerTheme");

    function applyTheme(theme) {

        const isDark = theme === "dark";

        document.body.classList.toggle(
            "dark-mode",
            isDark
        );

        if (themeIcon) {
            themeIcon.textContent =
                isDark ? "☀" : "☾";
        }

    }

    applyTheme(savedTheme || "light");

    if (themeToggle) {

        themeToggle.addEventListener(
            "click",
            function () {

                const isDark =
                    document.body.classList.contains(
                        "dark-mode"
                    );

                const nextTheme =
                    isDark ? "light" : "dark";

                localStorage.setItem(
                    "readerTheme",
                    nextTheme
                );

                applyTheme(nextTheme);

            }
        );

    }


    // ==========================================
    // FONT SIZE CONTROL
    // ==========================================

    const fontSizeSelect =
        document.getElementById("fontSize");

    const savedFontSize =
        localStorage.getItem("readerFontSize") || "16px";

    function applyFontSize(size) {

        document.querySelectorAll(
            ".chapter p, .chapter li, .chapter td"
        ).forEach(function (element) {

            element.style.fontSize = size;

        });

    }

    if (fontSizeSelect) {

        fontSizeSelect.value = savedFontSize;

        applyFontSize(savedFontSize);

        fontSizeSelect.addEventListener(
            "change",
            function () {

                localStorage.setItem(
                    "readerFontSize",
                    this.value
                );

                applyFontSize(this.value);

            }
        );

    }


    // ==========================================
    // FONT FAMILY CONTROL
    // ==========================================

    const fontFamilySelect =
        document.getElementById("fontFamily");

    const savedFontFamily =
        localStorage.getItem("readerFontFamily") ||
        "'DM Sans', sans-serif";

    function applyFontFamily(font) {

        document.querySelectorAll(
            ".chapter p, .chapter li, .chapter td"
        ).forEach(function (element) {

            element.style.fontFamily = font;

        });

    }

    if (fontFamilySelect) {

        fontFamilySelect.value = savedFontFamily;

        applyFontFamily(savedFontFamily);

        fontFamilySelect.addEventListener(
            "change",
            function () {

                localStorage.setItem(
                    "readerFontFamily",
                    this.value
                );

                applyFontFamily(this.value);

            }
        );

    }


    // ==========================================
    // MOBILE NAVIGATION
    // ==========================================

    const menuToggle =
        document.getElementById("menuToggle");

    const navLinks =
        document.getElementById("navLinks");

    if (menuToggle && navLinks) {

        menuToggle.addEventListener(
            "click",
            function () {

                const isOpen =
                    navLinks.classList.toggle("show");

                menuToggle.setAttribute(
                    "aria-expanded",
                    String(isOpen)
                );

            }
        );

        navLinks.querySelectorAll("a").forEach(
            function (link) {

                link.addEventListener(
                    "click",
                    function () {

                        navLinks.classList.remove("show");

                        menuToggle.setAttribute(
                            "aria-expanded",
                            "false"
                        );

                    }
                );

            }
        );

    }


    // ==========================================
    // TABLE OF CONTENTS ACTIVE SECTION
    // ==========================================

    const tocLinks =
        document.querySelectorAll(
            '.toc a[href^="#"]'
        );

    const chapters =
        document.querySelectorAll(
            ".chapter[id]"
        );

    if ("IntersectionObserver" in window) {

        const chapterObserver =
            new IntersectionObserver(
                function (entries) {

                    entries.forEach(function (entry) {

                        if (!entry.isIntersecting) {
                            return;
                        }

                        const currentId =
                            entry.target.id;

                        tocLinks.forEach(
                            function (link) {

                                const isCurrent =
                                    link.getAttribute("href") ===
                                    "#" + currentId;

                                link.classList.toggle(
                                    "current",
                                    isCurrent
                                );

                            }
                        );

                    });

                },
                {
                    rootMargin: "-110px 0px -65% 0px",
                    threshold: 0
                }
            );

        chapters.forEach(function (chapter) {

            chapterObserver.observe(chapter);

        });

    }


    // ==========================================
    // QUIZ CONFIGURATION
    // ==========================================

    const BOOK_ID = 9;

    const quizAnswers = {
        q1: "b",
        q2: "c",
        q3: "a",
        q4: "b",
        q5: "d",
        q6: "a",
        q7: "c",
        q8: "b",
        q9: "d",
        q10: "a"
    };

    const quizExplanations = {

        q1:
            "Authentication verifies the claimed identity " +
            "of a user or another entity.",

        q2:
            "Authorization determines which actions " +
            "and resources an entity may access.",

        q3:
            "Argon2id is a password-hashing algorithm " +
            "designed for secure password storage.",

        q4:
            "Least privilege grants users only " +
            "the permissions necessary for their tasks.",

        q5:
            "HTTPS uses TLS to protect information " +
            "transmitted between clients and servers.",

        q6:
            "Credential stuffing tests username and " +
            "password combinations obtained from breaches.",

        q7:
            "A failed authorization check must stop " +
            "the protected operation and deny access.",

        q8:
            "Schema validation verifies that incoming " +
            "messages follow the expected structure.",

        q9:
            "textContent treats the assigned value " +
            "as text instead of parsing it as HTML.",

        q10:
            "OAuth is an authorization framework. " +
            "OpenID Connect adds an authentication layer."

    };

    const quizForm =
        document.getElementById("quizForm");

    const quizProgress =
        document.getElementById("quizProgress");

    const quizResult =
        document.getElementById("quizResult");

    const submitQuiz =
        document.getElementById("submitQuiz");

    const retryQuiz =
        document.getElementById("retryQuiz");

    const totalQuestions =
        Object.keys(quizAnswers).length;

    let quizSubmitted = false;


    // ==========================================
    // UPDATE QUIZ PROGRESS
    // ==========================================

    function updateQuizProgress() {

        if (!quizForm || !quizProgress) {
            return;
        }

        let answered = 0;

        Object.keys(quizAnswers).forEach(
            function (questionName) {

                const selected =
                    quizForm.querySelector(
                        'input[name="' +
                        questionName +
                        '"]:checked'
                    );

                if (selected) {
                    answered++;
                }

            }
        );

        quizProgress.textContent =
            answered +
            " of " +
            totalQuestions +
            " answered";

    }

    if (quizForm) {

        quizForm.addEventListener(
            "change",
            updateQuizProgress
        );

    }


    // ==========================================
    // SUBMIT QUIZ
    // ==========================================

    if (quizForm) {

        quizForm.addEventListener(
            "submit",
            async function (event) {

                event.preventDefault();

                if (quizSubmitted) {
                    return;
                }

                let score = 0;
                let answered = 0;

                Object.keys(quizAnswers).forEach(
                    function (questionName) {

                        const selected =
                            quizForm.querySelector(
                                'input[name="' +
                                questionName +
                                '"]:checked'
                            );

                        if (selected) {
                            answered++;
                        }

                    }
                );

                if (answered < totalQuestions) {

                    alert(
                        "Please answer all " +
                        totalQuestions +
                        " questions before submitting."
                    );

                    return;

                }

                quizSubmitted = true;

                Object.keys(quizAnswers).forEach(
                    function (questionName) {

                        const correctAnswer =
                            quizAnswers[questionName];

                        const selected =
                            quizForm.querySelector(
                                'input[name="' +
                                questionName +
                                '"]:checked'
                            );

                        const questionNumber =
                            questionName.substring(1);

                        const questionContainer =
                            quizForm.querySelector(
                                '[data-question="' +
                                questionNumber +
                                '"]'
                            );

                        if (!questionContainer) {
                            return;
                        }

                        const correctInput =
                            quizForm.querySelector(
                                'input[name="' +
                                questionName +
                                '"][value="' +
                                correctAnswer +
                                '"]'
                            );

                        if (selected &&
                            selected.value === correctAnswer) {

                            score++;

                        }

                        if (correctInput) {

                            correctInput.closest(
                                "label"
                            ).classList.add(
                                "correct-answer"
                            );

                        }

                        if (selected &&
                            selected.value !== correctAnswer) {

                            selected.closest(
                                "label"
                            ).classList.add(
                                "wrong-answer"
                            );

                        }

                        const explanation =
                            document.createElement("div");

                        explanation.className =
                            "quiz-explanation";

                        explanation.textContent =
                            quizExplanations[questionName];

                        questionContainer.appendChild(
                            explanation
                        );

                    }
                );


                // Disable quiz inputs after submission

                quizForm.querySelectorAll(
                    'input[type="radio"]'
                ).forEach(function (input) {

                    input.disabled = true;

                });


                // Calculate percentage

                const percentage =
                    Math.round(
                        (score / totalQuestions) * 100
                    );

                const passed =
                    percentage >= 70;


                // Display quiz result

                if (quizResult) {

                    quizResult.hidden = false;

                    quizResult.innerHTML = "";

                    const heading =
                        document.createElement("h3");

                    heading.textContent =
                        passed
                            ? "Congratulations! You Passed!"
                            : "Keep Learning!";

                    const scoreText =
                        document.createElement("strong");

                    scoreText.textContent =
                        score +
                        " / " +
                        totalQuestions +
                        " (" +
                        percentage +
                        "%)";

                    const message =
                        document.createElement("p");

                    message.textContent =
                        passed
                            ? "You have successfully completed " +
                              "the Web Security assessment."
                            : "Review the lessons and try again " +
                              "to improve your score.";

                    quizResult.appendChild(heading);
                    quizResult.appendChild(scoreText);
                    quizResult.appendChild(message);

                }


                // Update buttons

                if (submitQuiz) {
                    submitQuiz.disabled = true;
                }

                if (retryQuiz) {
                    retryQuiz.hidden = false;
                }


                // ==========================================
                // SAVE QUIZ RESULT TO CODEVERSE SERVER
                // ==========================================

                try {

                    const response = await fetch(
                        "/api/quiz-results",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            credentials: "same-origin",

                            body: JSON.stringify({
                                bookId: BOOK_ID,
                                score: score,
                                totalQuestions: totalQuestions,
                                percentage: percentage
                            })
                        }
                    );

                    if (!response.ok) {

                        console.warn(
                            "Quiz result was not saved. " +
                            "HTTP status: " +
                            response.status
                        );

                    }

                } catch (error) {

                    console.warn(
                        "Quiz saving is unavailable:",
                        error.message
                    );

                }


                // Scroll to result

                if (quizResult) {

                    quizResult.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });

                }

            }
        );

    }


    // ==========================================
    // RETRY QUIZ
    // ==========================================

    if (retryQuiz) {

        retryQuiz.addEventListener(
            "click",
            function () {

                if (!quizForm) {
                    return;
                }

                quizSubmitted = false;

                quizForm.reset();

                quizForm.querySelectorAll(
                    'input[type="radio"]'
                ).forEach(function (input) {

                    input.disabled = false;

                });

                quizForm.querySelectorAll(
                    ".correct-answer, .wrong-answer"
                ).forEach(function (element) {

                    element.classList.remove(
                        "correct-answer",
                        "wrong-answer"
                    );

                });

                quizForm.querySelectorAll(
                    ".quiz-explanation"
                ).forEach(function (element) {

                    element.remove();

                });

                if (quizResult) {

                    quizResult.hidden = true;
                    quizResult.innerHTML = "";

                }

                if (submitQuiz) {

                    submitQuiz.disabled = false;

                }

                retryQuiz.hidden = true;

                updateQuizProgress();

                document.getElementById(
                    "quiz"
                ).scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });

            }
        );

    }


    // ==========================================
    // INITIALIZE QUIZ
    // ==========================================

    updateQuizProgress();

});
</script>

    <script src="/js/navbar-loader.js" defer></script>
