        rel="stylesheet"
    >

    <style>

        /* =====================================
           THEME VARIABLES
        ===================================== */

        :root {
            --bg: #f5f8ff;
            --surface: #ffffff;
            --text: #1b2b48;
            --muted: #67758d;
            --line: #e0e8f5;
            --blue: #315bb1;
            --blue2: #254687;
            --shadow: 0 18px 48px rgba(32, 58, 111, .10);
        }

        body.dark-mode {
            --bg: #101827;
            --surface: #1a273b;
            --text: #edf3ff;
            --muted: #afbdd3;
            --line: #35445c;
            --blue: #8db1ff;
            --blue2: #6f9afa;
            --shadow: 0 18px 48px rgba(0, 0, 0, .25);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "DM Sans", Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            transition: background .2s, color .2s;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button {
            font: inherit;
            cursor: pointer;
        }

        button:focus-visible,
        a:focus-visible {
            outline: 3px solid #f3b952;
            outline-offset: 3px;
        }

        /* =====================================
           NAVIGATION BAR
        ===================================== */

        .navbar {
            min-height: 80px;
            padding: 12px 5%;
            display: flex;
            align-items: center;
            gap: 28px;
            background: var(--surface);
            border-bottom: 1px solid var(--line);
            position: relative;
            z-index: 5;
            box-sizing: border-box;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 11px;
            font-size: 24px;
            font-weight: 800;
            white-space: nowrap;
        }

        .logo-highlight {
            color: var(--blue);
        }

        .site-logo {
            height: 43px;
            width: 43px;
            object-fit: contain;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 26px;
            margin-left: auto;
        }

        .nav-links a {
            font-size: 14px;
            font-weight: 700;
            color: var(--muted);
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: var(--blue);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .icon-btn,
        .menu-toggle {
            border: 1px solid var(--line);
            border-radius: 12px;
            background: var(--surface);
            color: var(--text);
            width: 42px;
            height: 42px;
            font-size: 23px;
        }

        .menu-toggle {
            display: none;
        }

        #accountActions {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .login-btn,
        .signup-btn {
            font-weight: 700;
            font-size: 13px;
            padding: 12px 16px;
            border-radius: 10px;
            white-space: nowrap;
        }

        .login-btn {
            border: 1px solid var(--line);
        }

        .signup-btn {
            background: #315bb1;
            color: white;
        }

        /* =====================================
           BACK TO LIBRARY
        ===================================== */

        .topbar {
            max-width: 1150px;
            margin: 24px auto 0;
            padding: 0 20px;
        }

        .back-link {
            font-size: 14px;
            font-weight: 700;
            color: var(--blue);
        }

        .back-link:hover {
            text-decoration: underline;
        }

        /* =====================================
           BOOK CONTAINER
        ===================================== */

        .book-container {
            max-width: 1150px;
            margin: 28px auto 85px;
            padding: 40px;
            display: grid;
            grid-template-columns: minmax(240px, 390px) 1fr;
            gap: clamp(30px, 6vw, 85px);
            align-items: center;
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 26px;
            box-shadow: var(--shadow);
            box-sizing: border-box;
        }

        .book-cover-container {
            display: flex;
            justify-content: center;
        }

        .book-cover-image {
            display: block;
            width: 100%;
            max-width: 360px;
            aspect-ratio: 3 / 4;
            object-fit: cover;
            border-radius: 16px;
            box-shadow: 15px 20px 32px rgba(20, 39, 77, .22);
        }

        /* =====================================
           BOOK DETAILS
        ===================================== */

        .featured-label {
            display: inline-block;
            background: rgba(49, 91, 177, .11);
            color: var(--blue);
            padding: 9px 13px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .09em;
        }

        .book-title {
            font-family: "Playfair Display", Georgia, serif;
            font-size: clamp(35px, 4.4vw, 58px);
            line-height: 1.13;
            letter-spacing: -.03em;
            margin: 20px 0;
        }

        .book-stats {
            display: flex;
            flex-wrap: wrap;
            gap: 24px;
            margin-bottom: 24px;
        }

        .stat {
            display: flex;
            flex-direction: column;
            gap: 3px;
            border-left: 3px solid var(--blue);
            padding-left: 13px;
        }

        .stat strong {
            font-size: 25px;
        }

        .stat span {
            font-size: 13px;
            color: var(--muted);
        }

        .book-description {
            font-size: 16px;
            line-height: 1.9;
            color: var(--muted);
            max-width: 550px;
        }

        /* =====================================
           ACTION BUTTONS
        ===================================== */

        .book-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 13px;
            margin-top: 28px;
        }

        .book-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 48px;
            padding: 12px 23px;
            border-radius: 12px;
            border: 1px solid var(--line);
            font-size: 14px;
            font-weight: 800;
            background: var(--surface);
            color: var(--text);
            box-sizing: border-box;
            transition: transform .2s, box-shadow .2s;
        }

        .book-btn.primary {
            background: #315bb1;
            border-color: #315bb1;
            color: white;
        }

        .book-btn.primary:hover {
            background: #254687;
        }

        .book-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(35, 65, 120, .12);
        }

        /* =====================================
           FOOTER
        ===================================== */

        .page-footer {
            text-align: center;
            padding: 0 20px 30px;
            color: var(--muted);
            font-size: 13px;
        }

        /* =====================================
           CONTENTS POPUP
        ===================================== */

        .contents-overlay {
            position: fixed;
            inset: 0;
            background: rgba(8, 18, 37, .65);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 20;
            padding: 20px;
            box-sizing: border-box;
        }

        .contents-overlay.show {
            display: flex;
        }

        .contents-modal {
            background: var(--surface);
            color: var(--text);
            border-radius: 22px;
            width: min(100%, 590px);
            max-height: min(86vh, 760px);
            display: flex;
            flex-direction: column;
            box-shadow: 0 28px 75px rgba(0, 0, 0, .28);
            overflow: hidden;
        }

        .contents-header {
            padding: 25px 28px;
            border-bottom: 1px solid var(--line);
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 15px;
        }

        .contents-subtitle {
            font-size: 11px;
            letter-spacing: .13em;
            font-weight: 800;
            color: var(--blue);
        }

        .contents-header h2 {
            font-family: "Playfair Display", Georgia, serif;
            font-size: 28px;
            margin: 7px 0 0;
        }

        .close-contents {
            background: transparent;
            border: 0;
            color: var(--muted);
            font-size: 32px;
            line-height: 1;
        }

        .contents-list {
            overflow-y: auto;
            overscroll-behavior: contain;
            scrollbar-width: thin;
            padding: 10px 20px 22px;
        }

        .contents-list a {
            display: flex;
            align-items: center;
            gap: 18px;
            padding: 16px 10px;
            border-bottom: 1px solid var(--line);
            font-weight: 700;
            font-size: 14px;
        }

        .contents-list a:hover,
        .contents-list a:focus-visible {
            color: var(--blue);
            background: rgba(49, 91, 177, .05);
        }

        .contents-number {
            min-width: 26px;
            color: var(--blue);
            font-size: 12px;
            font-weight: 800;
        }

        .contents-name {
            flex: 1;
        }

        .contents-arrow {
            margin-left: auto;
            font-size: 24px;
            color: var(--muted);
        }

        /* =====================================
           RESPONSIVE DESIGN
        ===================================== */

        @media (max-width: 900px) {

            .navbar {
                padding: 12px 20px;
                gap: 14px;
            }

            .nav-links {
                gap: 12px;
            }

            .book-container {
                margin: 25px 20px 60px;
                padding: 30px;
                gap: 30px;
                grid-template-columns: minmax(200px, 300px) 1fr;
            }

        }

        @media (max-width: 700px) {

            .navbar {
                min-height: 72px;
                flex-wrap: wrap;
            }

            .logo {
                font-size: 20px;
            }

            .site-logo {
                width: 37px;
                height: 37px;
            }

            .menu-toggle {
                display: block;
                order: 3;
            }

            .nav-actions {
                margin-left: auto;
            }

            .nav-links {
                display: none;
                order: 4;
                width: 100%;
                margin: 0;
                padding: 16px 0;
                border-top: 1px solid var(--line);
                flex-direction: column;
                align-items: stretch;
            }

            .nav-links.show {
                display: flex;
            }

            .nav-links a {
                padding: 8px;
            }

            .login-btn,
            .signup-btn {
                display: none;
            }

            .book-container {
                grid-template-columns: 1fr;
                padding: 28px 23px;
            }

            .book-cover-image {
                max-width: 280px;
            }

            .book-details {
                text-align: center;
            }

            .book-stats,
            .book-actions {
                justify-content: center;
            }

            .book-description {
                margin-left: auto;
                margin-right: auto;
            }

            .stat {
                text-align: left;
            }

        }

        @media (max-width: 390px) {

            .logo {
                font-size: 18px;
            }

            .navbar {
                padding: 12px;
            }

            .book-btn {
                width: 100%;
            }

            .contents-header {
                padding: 18px;
            }

            .contents-list {
                padding: 8px;
            }

        }

        @media (prefers-reduced-motion: reduce) {

            html {
                scroll-behavior: auto;
            }

            .book-btn,
            body {
                transition: none;
            }

        }

    </style>

</head>

