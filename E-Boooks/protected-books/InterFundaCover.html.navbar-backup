    <!-- =====================================
         JAVASCRIPT
    ===================================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /* =====================================
               MOBILE NAVIGATION
            ===================================== */

            const menu =
                document.getElementById("menuToggle");

            const nav =
                document.getElementById("navLinks");

            menu.addEventListener("click", function () {

                const opened =
                    nav.classList.toggle("show");

                menu.setAttribute(
                    "aria-expanded",
                    String(opened)
                );

            });

            /* =====================================
               DARK MODE
            ===================================== */

            const toggle =
                document.getElementById("themeToggle");

            const icon =
                document.getElementById("themeIcon");

            let theme = "light";

            try {

                theme =
                    localStorage.getItem("readerTheme") ||
                    localStorage.getItem("theme") ||
                    "light";

            } catch (error) {
                theme = "light";
            }

            function applyTheme() {

                const isDark = theme === "dark";

                document.body.classList.toggle(
                    "dark-mode",
                    isDark
                );

                icon.textContent =
                    isDark ? "☀" : "☾";

                toggle.setAttribute(
                    "aria-label",
                    isDark
                        ? "Switch to light mode"
                        : "Switch to dark mode"
                );

            }

            applyTheme();

            toggle.addEventListener("click", function () {

                theme =
                    theme === "dark"
                        ? "light"
                        : "dark";

                try {

                    localStorage.setItem(
                        "readerTheme",
                        theme
                    );

                    localStorage.setItem(
                        "theme",
                        theme
                    );

                } catch (error) {
                    // Theme still changes for this session.
                }

                applyTheme();

            });

            /* =====================================
               CONTENTS POPUP
            ===================================== */

            const btn =
                document.getElementById("contentsBtn");

            const overlay =
                document.getElementById("contentsPopup");

            const close =
                document.getElementById("closeContents");

            let previousFocus = null;

            function setModal(open) {

                overlay.classList.toggle("show", open);

                overlay.setAttribute(
                    "aria-hidden",
                    String(!open)
                );

                document.body.style.overflow =
                    open ? "hidden" : "";

                if (open) {

                    previousFocus = document.activeElement;

                    close.focus();

                } else if (previousFocus) {

                    previousFocus.focus();

                }

            }

            btn.addEventListener("click", function () {
                setModal(true);
            });

            close.addEventListener("click", function () {
                setModal(false);
            });

            overlay.addEventListener("click", function (event) {

                if (event.target === overlay) {
                    setModal(false);
                }

            });

            /* =====================================
               KEYBOARD ACCESSIBILITY
            ===================================== */

            document.addEventListener("keydown", function (event) {

                if (!overlay.classList.contains("show")) {
                    return;
                }

                if (event.key === "Escape") {

                    setModal(false);
                    return;

                }

                if (event.key === "Tab") {

                    const focusable = [
                        close,
                        ...overlay.querySelectorAll(".contents-list a")
                    ];

                    const first = focusable[0];

                    const last =
                        focusable[focusable.length - 1];

                    if (
                        event.shiftKey &&
                        document.activeElement === first
                    ) {

                        event.preventDefault();
                        last.focus();

                    } else if (
                        !event.shiftKey &&
                        document.activeElement === last
                    ) {

                        event.preventDefault();
                        first.focus();

                    }

                }

            });

        });

    </script>

